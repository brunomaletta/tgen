#include "../single_include/tgen.h"

namespace tgen {

/**
 * @defgroup base Base Operations
 * @brief Operations for basic number generation and basic random operations.
 *
 * ### Examples
 *
 * ```cpp
 * // Random number from 10 to 20.
 * int size = tgen::next(10, 20);
 * tgen_ensure(size <= 20);
 *
 * // Several numbers in {5, 10, 15, 20}.
 * std::vector<int> v(size);
 * for (int& i : v) i = tgen::any({5, 10, 15, 20});
 *
 * // Shuffles the numbers.
 * tgen::shuffle(v.begin(), v.end());
 *
 * // Choses a subsequence of length 5.
 * v = tgen::choose(5, v);
 * ```
 */





/**
 * @ingroup base
 * @brief Ensures condition is true.
 *
 * @param cond Condition to me ensured.
 * @param ... Empty or a string with an error message.
 *
 * @throws std::runtime_error if @pname{cond} is not true.
 *
 * #### Examples
 *
 * ```cpp
 * // Without error message:
 * tgen_ensure(a == b);
 * // With error message:
 * tgen_ensure(a == b, "values must be the same");
 * ```
 *
 * \hideinitializer
 * \def tgen_ensure(cond, ...)
 */





/**
 * @ingroup base
 * @brief Printer helper for standard types.
 *
 * Just call @tt{std::cout << @namespace{tgen}::print(x)} to print @tt{x}, or
 * @tt{@namespace{std}::cout << @namespace{tgen}::println(x)} to
 * print @tt{x} and @tt{\\n}. Works with @tt{@namespace{std}::initializer_list}.
 *
 * Prints @tt{@namespace{std}::pair}, @tt{@namespace{std}::tuple} and containers nicely (separade by a space).
 * Matrices (@tt{container<container<T>>}) are also handleled nicely, printing one
 * row per line.
 *
 * #### Examples
 *
 * ```cpp
 * std::tuple<int, double, std::string> tu = {5, 0.1, "str"};
 * std::cout << tgen::print(tu);
 * // "5 0.1 str"
 * std::cout << tgen::print({{1, 2}, {3, 4}}, ',');
 * // "1,2\n3,4"
 * ```
 *
 * @struct print;
 */


/**
 * @brief Cretes a printer object.
 *
 * @param val Value to be printed.
 * @param sep Separator for values printed in the same line.
 *
 * @fn print::print(const T &val, char sep = ' ');
 */


/**
 * @brief Prints printer object.
 *
 * @param out Stream to print to.
 * @param pr Printer object.
 *
 * @fn print::operator<<(std::ostream &out, const print &pr);
 */





/**
 * @ingroup base
 * @brief Printer helper for standard types, printing on a new line.
 *
 * Same as @ref print, but prints on a new line (appending a @tt{\n} at the end).
 *
 * #### Examples
 *
 * ```cpp
 * std::tuple<int, double, std::string> tu = {5, 0.1, "str"};
 * std::cout << tgen::println(tu);
 * // "5 0.1 str\n"
 * std::cout << tgen::print({{1, 2}, {3, 4}}, ',');
 * // "1,2\n3,4\n"
 * ```
 *
 * @struct println;
 */


/**
 * @brief Cretes a printer object that prints on a new line.
 *
 * @param val Value to be printed.
 * @param sep Separator for values printed in the same line.
 *
 * @fn println::println(const T &val, char sep = ' ');
 */


/**
 * @brief Prints printer object on a new line.
 *
 * @param out Stream to print to.
 * @param pr Printer object.
 *
 * @fn println::operator<<(std::ostream &out, const println &pr);
 */





/**
 * @ingroup base
 * @brief Returns a random number up to value.
 *
 * @tparam T type to be generated. Should be an arithmetic type: @primitive{int}, @primitive{double}, @primitive{long long}, @primitive{char}, etc.
 *
 * @param n Endpoint of the range.
 *
 * @return A random number in @tt{[@pname{0}, @pname{n})}, chosen uniformly.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Random value from 0 to 9.
 * int value = tgen::next(10);
 * // Probability 1/3:
 * bool odds = tgen::next<double>(3) < 1.0;
 * ```
 *
 * @fn next(T n);
 */


/**
 * @ingroup base
 * @brief Returns a random number in range.
 *
 * @tparam T type to be generated. Should be an arithmetic type: @primitive{int}, @primitive{double},
 *         @primitive{long long}, @primitive{char}, etc.
 *
 * @param l Left endpoint of the range.
 * @param r Light endpoint of the range.
 *
 * @return A random number in @tt{[@pname{l}, @pname{r}]}, chosen uniformly.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Random value from 1 to 10.
 * int value = tgen::next(1, 10);
 * ```
 *
 * @fn next(T l, T r);
 */


/**
 * @ingroup base
 * @brief Returns random index with given probabilities.
 *
 * @param distribution Probability distribution.
 *
 * @return @tt{i} in @tt{[0, @pname{distribution}.size()-]} with probability proportional to
 *         @tt{@pname{distribution}[i]}.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{distribution}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * // 0 or 1; 1000 times more likely to generate 1.
 * int value = tgen::next_by_distribution({1, 1000});
 * ```
 *
 * @fn next_by_distribution(const std::vector<T> &distribution);
 */


/**
 * @ingroup base
 * @brief Shuffles range inplace, for random_access_iterator.
 *
 * @param first First iterator of range.
 * @param last First iterator outside of range.
 *
 * Shuffles @tt{[@pname{first}, @pname{last})} uniformly inplace. Works for
 * @texttt{@namespace{std}::@type{vector}}, @texttt{@namespace{std}::@type{string}}, etc, but not
 * @texttt{@namespace{std}::@type{set}}. For those, use @tt{tgen::shuffled(@pname{container})}.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{last} - @pname{first}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * std::vector<int> v = {1, 2, 3, 4, 5};
 * tgen::shuffle(v.begin(), v.end());
 * ```
 *
 * @fn shuffle(It first, It last);
 */


/**
 * @ingroup base
 * @brief Shuffles a container.
 *
 * @param container Container to be shuffled.
 *
 * Works for containers and @texttt{@namespace{std}::@type{initializer_list}}. If @pname{container} is ordered
 * (@texttt{@namespace{std}::@type{set}}, etc) or @texttt{@namespace{std}::@type{initializer_list}}, returns a
 * @texttt{@namespace{std}::@type{vector}} (implemented in a different function).
 *
 * @return The shuffled container.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{container}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * std::vector<int> st = {1, 2, 3, 4, 5};
 * st = tgen::shuffled(st);
 * st = tgen::shuffled({1, 2, 3});
 * st = tgen::shuffled(std::set<int>({1, 2, 3}));
 * ```
 *
 * @fn shuffled(const C &container);
 */


/**
 * @ingroup base
 * @brief Choses a random element from iterator range.
 *
 * @param first First iterator of range.
 * @param last First iterator outside of range.
 *
 * @return A uniformly random element from the range @tt{[@pname{first}, @pname{last})}.
 *
 * #### Complexity
 *
 * @tt{O(1)} for random_access_iterator, @tt{O(|@pname{last} - @pname{first}|)} otherwise.
 *
 * #### Examples
 *
 * ```cpp
 * std::set<int> st = {1, 2, 3, 4, 5};
 * int value = tgen::any(st.begin(), st.end());
 * ```
 *
 * @fn any(It first, It last);
 */


/**
 * @ingroup base
 * @brief Choses a random element from container.
 *
 * @param container Container to choose from.
 *
 * Also works with @texttt{@namespace{std}::@type{initializer_list}}.
 *
 * @return A uniformly random element from @pname{container}.
 *
 * #### Complexity
 *
 * @tt{O(1)} for random_access_iterator, @tt{O(|@pname{container}|)} otherwise.
 *
 * #### Examples
 *
 * ```cpp
 * std::vector<int> v = {1, 2, 3, 4, 5};
 * int value = tgen::any(v);
 * ```
 *
 * @fn any(const C &container);
 */


/**
 * @ingroup base
 * @brief Choses a random element with given probabilities.
 *
 * @param container Container to choose from.
 * @param distribution Probability distribution.
 *
 * Also works with @texttt{@namespace{std}::@type{initializer_list}}.
 *
 * @return For @tt{i} in @tt{[0, @pname{container}.size()-1]}, @tt{@pname{container}[i]} with probability
 *         proportional to @tt{@pname{distribution}[i]}.
 *
 * #### Complexity
 *
 * @tt{O(1)} for random_access_iterator, @tt{O(|@pname{container}|)} otherwise.
 *
 * #### Examples
 *
 * ```cpp
 * // Generates chars with custom odds.
 * int value = tgen::any_by_distribution({"a", "b", "c"}, {1, 2, 3});
 * ```
 *
 * @fn any_by_distribution(const C &container, std::vector<T> distribution);
 */


/**
 * @ingroup base
 * @brief Chooses elements from container, as in a subsequence fixed length.
 *
 * @param k Number of elements to be chosen.
 * @param container Container to choose from.
 *
 * Also works with @texttt{@namespace{std}::@type{initializer_list}}.
 *
 * @return A uniformly random subsequence of length @pname{k}.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{container}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * std::vector<int> v = {1, 2, 3, 4, 5};
 * v = tgen::choose(3, v); // Chooses 3 elements from v.
 * ```
 *
 * @fn choose(int k, const C &container);
 */


/**
 * @ingroup base
 * @brief Distinct generator for integral ranges.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints 3 distinct numbers from 1 to 10, uniformly at random.
 * tgen::distinct_range d(1, 10);
 * std::cout << d.gen() << " " << d.gen() << " " << d.gen() << std::endl;
 * ```
 *
 * @struct distinct_range;
 */


/**
 * @brief Creates distinct generator for values in given range.
 *
 * @param l Left endpoint of the range.
 * @param r Right endpoint of the range.
 *
 * The generator will generate values in @tt{[@pname{l}, @pname{r}]}.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates a generator for distinct nubers from 5 to 10.
 * auto distinct = tgen::distinct_range(5, 10);
 * ```
 *
 * @fn distinct_range::distinct_range(T l, T r);
 */


/**
 * @brief Returns the number of values left to generate.
 *
 * @return The number of values left to generate.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints current size of distinct generator.
 * tgen::distinct_range d(5, 10);
 * d.gen(), d.gen();
 * std::cout << d.size() << std::endl;
 * // "4"
 * ```
 *
 * @fn distinct_range::size();
 */


/**
 * @brief Generates a unique random value in the defined range.
 *
 * @return A value in the given range that has not been generated before, uniformly at random.
 *
 * @throws std::runtime_error if there no more values to generate.
 *
 * #### Complexity
 *
 * @tt{O(log(n))} for the @tt{n}-th call of @tt{gen}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints 3 distinct numbers from 1 to 10, uniformly at random.
 * tgen::distinct_range d(1, 10);
 * std::cout << d.gen() << " " << d.gen() << " " << d.gen() << std::endl;
 * ```
 *
 * @fn distinct_range::gen();
 */


/**
 * @ingroup base
 * @brief Distinct generator for containers.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints 3 distinct from the set.
 * std::set<int> s = {3, 5, 9};
 * tgen::distinct_container d(s);
 * std::cout << d.gen() << " " << d.gen() << " " << d.gen() << std::endl;
 * ```
 *
 * @struct distinct_container;
 */


/**
 * @brief Creates distinct generator for elements of the given container.
 *
 * @param container Container.
 *
 * The generator will generate distinct elements from container.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates a generator distinct elements from s.
 * std::set<int> s = {3, 5, 9};
 * auto distinct = tgen::distinct_container(s);
 * ```
 *
 * @fn distinct_container::distinct_container(const C &container);
 */


/**
 * @brief Returns the number of elements left to generate.
 *
 * @return The number of elements left to generate.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints current size of distinct generator.
 * std::set<int> s = {3, 5, 9};
 * tgen::distinct_container d(s);
 * d.gen();
 * std::cout << d.size() << std::endl;
 * // "2"
 * ```
 *
 * @fn distinct_container::size();
 */


/**
 * @brief Generates a unique random element from the container.
 *
 * @return An element from the container that has not been generated before, uniformly at random.
 *
 * @throws std::runtime_error if there no more elements to generate.
 *
 * #### Complexity
 *
 * @tt{O(log(n))} for the @tt{n}-th call of @tt{gen}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints 3 distinct from the set.
 * std::set<int> s = {3, 5, 9};
 * tgen::distinct_container d(s);
 * std::cout << d.gen() << " " << d.gen() << " " << d.gen() << std::endl;
 * ```
 *
 * @fn distinct_container::gen();
 */





/**
 * @ingroup base
 * @brief Unique generator for discrete functions.
 *
 * ### Examples
 *
 * ```cpp
 * ```
 *
 * @struct unique;
 */


/**
 * @brief Generates a unique generator of a discrete function.
 *
 * @tparam Func Automatically set to the function type.
 *
 * @param f The function.
 *
 * #### Examples
 *
 * ```cpp
 * // Generates unique generator for prime numbers.
 * auto g = tgen::unique(gen_prime);
 * ```
 *
 * @fn unique::unique(Func f);
 */


/**
 * @brief Generates a unique value.
 *
 * @tparam Func Automatically set to the function type.
 *
 * @param args Arguments for the function call.
 *
 * @return A new value that has not been generated before, uniformly at random.
 *
 * @throws std::runtime_error if there are probably (with probability at least @tt{1 - 10^(-18)}) no
 *         more unique instances to generate.
 *
 * #### Complexity
 *
 * @tt{O(T * log^2(k))} amortized expected, if the function runs in @tt{O(T)} time
 * and @tt{k} unique values have been generated.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints some random distinct strings.
 * auto g = tgen::str("[a-z]{10}").distinct();
 * for (int i = 0; i < 10; ++i)
 *     std::cout << g.gen() << std::endl;
 *
 * // Generates some random distinct primes in [1, 100].
 * auto g = tgen::unique(gen_prime);
 * for (int i = 0; i < 10; ++i)
 *     std::cout << g.gen(1, 100) << std::endl;
 * ```
 *
 * @fn unique::gen(Args &&...args);
 */


/**
 * @brief Generates a list of several unique values.
 *
 * @tparam Func Automatically set to the function type.
 *
 * @param size Size of the list to be generated.
 * @param args Arguments for the function call.
 *
 * @return A uniformly random @tt{@namespace{std}::@type{vector}} with @pname{size}
 *         unique values from the function with the given arguments.
 *
 * #### Complexity
 *
 * @tt{@pname{size}} times the complexity of one @ref tgen::unique::gen call.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints 10 random unique strings.
 * std::cout << print(tgen::str("[a-z]{5}").distinct().gen_list(10)) << std::endl;
 * ```
 *
 * @fn unique::gen_list(int size, Args &&...args);
 */


/**
 * @brief Checks if there is nothing left to generate.
 *
 * @param args Arguments for the function call.
 *
 * @return If ther is probably (with probability at least @tt{1 - 10^(-18)}) no value that has not been generated yet.
 *
 * #### Complexity
 *
 * Linear in the worst case, but amortizes together with @ref tgen::unique::gen if it is always called after this check.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints all primes in [1, 10].
 * auto g = tgen::unique(tgen::math::gen_prime);
 * while (!g.empty(1, 10)) std::cout << g.gen(1, 10) << std::endl;
 * ```
 *
 * @fn unique::empty(Args &&...args);
 */


/**
 * @brief Generates all unique values left to generate.
 *
 * @param args Arguments for the function call.
 *
 * @return A uniformly random @tt{@namespace{std}::@type{vector}} all
 *         unique values from the function with the given arguments
 *         that have not been generated yet.
 *
 * #### Complexity
 *
 * The same as calling @ref tgen::unique::gen until there are no more unique values.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints all primes in [1, 10].
 * std::cout << print(tgen::unique(tgen::math::gen_prime).gen_all(1, 10)) << std::endl;
 * ```
 *
 * @fn unique::gen_all(Args &&...args);
 */





/**
 * @ingroup base
 * @brief Base class for generators (should not be instantiated).
 *
 * ### Examples
 *
 * ```cpp
 * ```
 *
 * @struct gen_base;
 */


/**
 * @brief Generates a list of several generation calls.
 *
 * @tparam Gen Automatically set to the given type.
 *
 * @param size Size of the list to be generated.
 * @param args Arguments for the @tt{tgen::@type{Gen}::gen} call.
 *
 * @return A @tt{@namespace{std}::@type{vector}<tgen::@type{Gen}::instance>} with @pname{size}
 *         calls to @tt{tgen::@type{gen}::gen(@pname{args}...)}.
 *
 * #### Complexity
 *
 * @tt{@pname{size}} times the complexity of one @tt{tgen::@type{Gen}::gen(@pname{args}...)} call.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates unique generator of strings of size n.
 * tgen::gen_unique g = tgen::str("[a-z]{%d}", n).unique();
 * ```
 *
 * @fn gen_base::gen_list(int size, Args &&...args) const;
 */


/**
 * @brief Generates a random instance from the valid set until a condition is met.
 *
 * @tparam Gen Automatically set to the given type.
 *
 * @param predicate Condition to be checked. Should be a function that takes in a
 *        @tt{@type{Gen}::instance}, and returns a @primitive{bool}.
 * @param max_tries The maximum number of times the function will try to generate a valid instance
 *        satisfying @pname{predicate}.
 * @param args Arguments for the the function @tt{tgen::@type{Gen}::gen}.
 *
 * Calls @tt{tgen::@type{Gen}::gen(@pname{args}...)} until @pname{predicate} is true, at most @pname{max_tries} times.
 * If @pname{predicate} has probabiliyy @tt{p} of returning @tt{true}, then the instance
 * will be found with probability @tt{1 - (1-p)^@pname{max_tries}}.
 *
 * @return A @tt{tgen::@type{Gen}::instance} found by repeatedly choosing a uniformly random valid permutation and checking
 * if it satisfies @pname{predicate}.
 *
 * @throws std::runtime_error if no valid instance satisfying @pname{predicate} is found after @pname{max_tries}
 *         tries.
 *
 * #### Complexity
 *
 * @tt{O(T(n) * (1 / p))} expected, if @tt{@type{Gen}::instance} runs in @tt{O(T(n))} time, and @pname{predicate} has probability
 * @tt{p} of returning @tt{true}.
 * @tt{O(T(n) * @pname{max_tries})}, worst case.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints a sequence of 10 distinct ints from 1 to 10 such that the first element is larger than the last.
 * std::cout <<
 *     tgen::sequence<int>(10, 1, 10)
 *         .distinct()
 *         .gen_until([](const auto &seq) { return seq[0] < seq[9]; }, 100)
 * 	 << std::endl;
 *
 * // Prints a random odd permutation of size 5.
 * std::cout <<
 *     tgen::permutation(5)
 *         .gen_until([](const auto &perm) { return perm.parity() == -1; }, 100)
 * 	 << std::endl;
 * 
 * // Prints a random odd permutation of size 5 with one cycle.
 * std::cout <<
 *     tgen::permutation(5)
 *         .gen_until([](const auto &perm) { return perm.parity() == -1; }, 100, {5})
 * 	 << std::endl;
 *
 * // Prints a string of 10 letters that starts and ends with the same character.
 * std::cout <<
 *     tgen::str("[a-zA-Z]{10}")
 *         .gen_until([](const auto &s) { return s[0] == s[9]; }, 100)
 * 	 << std::endl;
 * ```
 *
 * @fn gen_base::gen_until(Pred predicate, int max_tries, Args &&...args) const;
 */


/**
 * @brief Creates unique generator for current generator.
 *
 * @tparam Gen Automatically set to the given type.
 *
 * @return The @ref tgen::gen_unique generator that calls @tt{tgen::@type{Gen}::gen}.
 *
 * #### Complexity
 *
 * Linear.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates unique generator of strings of size n.
 * tgen::gen_unique g = tgen::str("[a-z]{%d}", n).unique() const;
 * ```
 *
 * @fn gen_base::unique();
 */





/**
 * @ingroup base
 * @brief Base class for generator instances (should not be instantiated).
 *
 * ### Examples
 *
 * ```cpp
 * ```
 *
 * @struct gen_instance_base;
 */


/**
 * Comparator for generator instances.
 *
 * @tparam Inst Automatically set to the given type.
 *
 * @param rhs Right-hand side of the comparison.
 *
 * @return If this instance is less than the right-hand side instance.
 *
 * Uses @tt{@pname{Inst}::to_std} for the comparison.
 *
 * #### Complexity
 *
 * Linear.
 *
 * #### Examples
 *
 * ```cpp
 * // Checks if one string is lexicographically smaller than the other.
 * std::cout (tgen::str::instance("aba") < tgen::str::instance("abc")) << std::endl;
 * ```
 *
 * @fn gen_instance_base::operator<(const Inst &rhs) const;
 */





/**
 * @defgroup generator_instance_op Generator Instance Operations
 * @ingroup base
 * @brief Operations for @tt{tgen} generator instances.
 *
 * ### Examples
 *
 * ```cpp
 * ```
 */


/**
 * @ingroup generator_instance_op
 * @brief Shuffles a sequence instance.
 *
 * @tparam Inst Sequence instance type, deduced automatically. Must be a `tgen::sequence::instance`.
 *
 * @param inst The instance to shuffle.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{inst}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Shuffles and prints an instance.
 * tgen::sequence<int>::instance inst = {3, 1, 2};
 * tgen::shuffle(inst);
 * ```
 *
 * @fn shuffle(Inst &inst);
 */


/**
 * @ingroup generator_instance_op
 * @brief Shuffles a sequence instance.
 *
 * @tparam Inst Sequence instance type, deduced automatically. Must be a `tgen::sequence::instance`.
 *
 * @param inst The original instance.
 *
 * @return The shuffled instance.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{inst}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Shuffles and prints an instance.
 * tgen::sequence<int>::instance inst = {3, 1, 2};
 * std::cout << tgen::shuffled(inst) << std::endl;
 * ```
 *
 * @fn shuffled(const Inst &inst);
 */


/**
 * @ingroup generator_instance_op
 * @brief Choses a random element from the sequence instance.
 *
 * @tparam Inst Sequence instance type, deduced automatically. Must be a `tgen::sequence::instance`.
 *
 * @param inst The original instance.
 *
 * @return A uniformly random element from the instance.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints a random element from v.
 * tgen::sequence<int>::instance inst = {3, 1, 2};
 * std::cout << tgen::any(inst) << std::endl;
 * ```
 *
 * @fn any(const Inst &inst);
 */


/**
 * @ingroup generator_instance_op
 * @brief Choses a random element from the sequence instance.
 *
 * @tparam Inst Sequence instance type, deduced automatically. Must be a `tgen::sequence::instance`.
 *
 * @param inst The instance to choose from.
 * @param distribution The probability distribution.
 *
 * @return A uniformly random element from the instance.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints a random element from instance with given odds.
 * tgen::sequence<int>::instance inst = {3, 1, 2};
 * std::cout << tgen::any_by_distribution(inst, {1, 2, 3}) << std::endl;
 * ```
 *
 * @fn any_by_distribution(const Inst &inst, const std::vector<T> &distribution);
 */


/**
 * @ingroup generator_instance_op
 * @brief Chooses some values from the sequence instance, as in a subsequence of fixed length.
 *
 * @tparam Inst Sequence instance type, deduced automatically. Must be a `tgen::sequence::instance`.
 *
 * @param k The size of the subsequence.
 * @param inst The original instance.
 *
 * @return A uniformly random subsequence of length @pname{k}.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{inst}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints a subsequenec of length 2 from v.
 * tgen::sequence<int>::instance inst = {3, 1, 2};
 * std::cout << tgen::choose(2, inst) << std::endl;
 * ```
 *
 * @fn choose(int k, const Inst &inst);
 */





/**
 * @brief If type is associative container.
 *
 * True for @tt{@namespace{std}::@type{set}}, @tt{@namespace{std}::@type{map}}, etc.
 *
 * @struct is_associative_container;
 */


/**
 * @brief If type is a @tt{tgen} generator instance.
 *
 * @struct is_generator_instance;
 */


/**
 * @brief If type is a sequence-like @tt{tgen} generator instance.
 *
 * @struct is_sequential;
 */


/**
 * @brief If type is defined for a subset of itself, for @tt{tgen} generator instance.
 *
 * @struct has_subset_defined;
 */


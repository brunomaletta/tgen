#include "../single_include/tgen.h"

namespace tgen {

/**
 * @defgroup base Base Operations
 * @brief Operations for basic number generation and basic random operations.
 *
 * ### Examples
 *
 * ```cpp
 * // Random number from 10 to 20.
 * int size = tgen::next(10, 20);
 * tgen_ensure(size <= 20);
 *
 * // Several numbers in {5, 10, 15, 20}.
 * std::vector<int> v(size);
 * for (int& i : v) i = tgen::pick({5, 10, 15, 20});
 *
 * // Shuffles the numbers.
 * tgen::shuffle(v.begin(), v.end());
 *
 * // Chooses a subsequence of length 5.
 * v = tgen::choose(v, 5);
 * ```
 */





/**
 * @ingroup base
 * @brief Ensures condition is true.
 *
 * @param cond Condition to be ensured.
 * @param ... Empty or a string with an error message.
 *
 * @throws std::runtime_error if @pname{cond} is not true.
 *
 * #### Examples
 *
 * ```cpp
 * int a = 2, b = 2;
 * // Without error message:
 * tgen_ensure(a == b);
 * // With error message:
 * tgen_ensure(a == b, "values must be the same");
 * ```
 *
 * \hideinitializer
 * \def tgen_ensure(cond, ...)
 */





/**
 * @ingroup base
 * @brief Printer helper for standard types.
 *
 * Just call @tt{std::cout << @namespace{tgen}::print(x)} to print @tt{x}, or
 * @tt{@namespace{std}::cout << @namespace{tgen}::println(x)} to
 * print @tt{x} and @tt{\\n}. Works with @tt{@namespace{std}::initializer_list}.
 *
 * Prints @tt{@namespace{std}::pair}, @tt{@namespace{std}::tuple} and containers nicely (separated by a space).
 * Matrices (@tt{container<container<T>>}) are also handled nicely, printing one
 * row per line.
 *
 * ### Examples
 *
 * ```cpp
 * std::tuple<int, double, std::string> tu = {5, 0.1, "str"};
 * std::cout << tgen::print(tu) << std::endl;
 * std::cout << tgen::print({{1, 2}, {3, 4}}, ',') << std::endl;
 * ```
 *
 * ```
 * 5 0.1 str
 * 1,2
 * 3,4
 * ```
 *
 * @struct print;
 */


/**
 * @brief Creates a printer object.
 *
 * @param val Value to be printed.
 * @param sep Separator for values printed in the same line.
 *
 * @fn print::print(const T &val, char sep = ' ');
 */


/**
 * @brief Prints printer object.
 *
 * @param out Stream to print to.
 * @param pr Printer object.
 *
 * @fn print::operator<<(std::ostream &out, const print &pr);
 */





/**
 * @ingroup base
 * @brief Printer helper for standard types, printing on a new line.
 *
 * Same as @ref print, but prints on a new line (appending a @tt{\n} at the end).
 *
 * ### Examples
 *
 * ```cpp
 * std::tuple<int, double, std::string> tu = {5, 0.1, "str"};
 * std::cout << tgen::println(tu);
 * std::cout << tgen::print({{1, 2}, {3, 4}}, ',');
 * ```
 *
 * ```
 * 5 0.1 str
 * 1,2
 * 3,4
 * ```
 *
 * @struct println;
 */


/**
 * @brief Creates a printer object that prints on a new line.
 *
 * @param val Value to be printed.
 * @param sep Separator for values printed in the same line.
 *
 * @fn println::println(const T &val, char sep = ' ');
 */


/**
 * @brief Prints printer object on a new line.
 *
 * @param out Stream to print to.
 * @param pr Printer object.
 *
 * @fn println::operator<<(std::ostream &out, const println &pr);
 */





/**
 * @ingroup base
 * @brief Printer helper for printing containers or sequential generator elements as columns.
 *
 * If you pass multiple parameters for the printer, it will print the @tt{i}-th element of each
 * on the @tt{i}-th line.
 *
 * @warning When you have multiple columns, do not pass arguments that call for random generation
 *          directly in the same function call, e.g.
 *          @tt{print_cols(tgen::next(1, 10), tgen::next(1, 10))} or
 *          @tt{print_cols(tgen::list(5, 1, 10).gen(), tgen::list(5, 1, 10).gen())}. Function
 *          arguments are evaluated in unspecified order, so which random draws appear in which
 *          column can vary between compilers. Evaluate each random value into a named variable
 *          first, then pass those variables to @ref print_cols.
 *
 * ### Examples
 *
 * ```cpp
 * std::vector<int> a = {1, 2};
 * tgen::list<int>::value b({3, 4});
 * std::cout << tgen::print_cols(a, b);
 * ```
 *
 * ```
 * 1 3
 * 2 4
 * ```
 *
 * @struct print_cols;
 */


/**
 * @brief Creates a printer object that prints as columns.
 *
 * @param args Arguments. Each argument should be either a container or a sequential generator value
 * (e.g. @ref list::value, @ref str::value, @ref permutation::value).
 *
 * @fn print_cols::print_cols(const Args &...args);
 */


/**
 * @brief Prints printer object as columns.
 *
 * @param out Stream to print to.
 * @param pr Printer object.
 *
 * @fn print_cols::operator<<(std::ostream &out, const print_cols &pr);
 */





/**
 * @ingroup base
 * @brief Returns a random number smaller than value.
 *
 * @tparam T type to be generated. Should be an arithmetic type: @primitive{int}, @primitive{double}, @primitive{long long}, @primitive{char}, etc.
 *
 * @param right Endpoint of the range.
 *
 * @return A random number in @tt{[0, @pname{right})}, chosen uniformly.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Random value from 0 to 9.
 * int value = tgen::next(10);
 * // Probability 1/3:
 * bool odds = tgen::next<double>(3) < 1.0;
 * ```
 *
 * @fn next(T right);
 */


/**
 * @ingroup base
 * @brief Returns a random number in range.
 *
 * @tparam T type to be generated. Should be an arithmetic type: @primitive{int}, @primitive{double},
 *         @primitive{long long}, @primitive{char}, etc.
 *
 * @param left Left endpoint of the range.
 * @param right Right endpoint of the range.
 *
 * @return A random number in @tt{[@pname{left}, @pname{right}]}, chosen uniformly.
 *
 * @note For floating-point types, sampling uses @tt{std::uniform_real_distribution}
 *       (@tt{[@pname{left}, @pname{right})} in C++). This matches the documented
 *       closed interval because the right endpoint has probability zero.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Random value from 1 to 10.
 * int value = tgen::next(1, 10);
 * ```
 *
 * @fn next(T left, T right);
 */


/**
 * @ingroup base
 * @brief Returns a skewed random number smaller than value.
 *
 * @tparam T Arithmetic type, same as for @tt{tgen::next}.
 *
 * @param right Right endpoint (half-open range), same convention as @tt{tgen::next(@pname{right})}.
 * @param w Skew parameter.
 *
 * @return A value in @tt{[0, @pname{right})} with bias controlled by @pname{w}.
 *
 * - @tt{@pname{w} = 0}: uniform distribution.
 * - @tt{@pname{w} > 0}: returns the maximum of @tt{(@pname{w} + 1)} independent uniform samples.
 *                       Biases the distribution toward larger values. The resulting density is proportional to @tt{f(x) = x^@pname{w}}.
 *                       In particular:
 *                       - @tt{@pname{w} = 1}: linear bias;
 *                       - @tt{@pname{w} = 2}: quadratic bias;
 *                       - @tt{@pname{w} = 3}: cubic bias.
 * - @tt{@pname{w} < 0}: returns the minimum of @tt{(-@pname{w} + 1)} independent uniform samples. Symmetric to the @tt{@pname{w} > 0} case.
 *
 * The continuous version corresponds to Beta distributions:
 * - @tt{@pname{w} > 0}: @tt{Beta(@pname{w} + 1, 1)};
 * - @tt{@pname{w} < 0}: @tt{Beta(1, -@pname{w} + 1)}.
 *
 * \htmlinclude wnext_distribution.html
 *
 * @note Distribution might be slightly biased because of floating point arithmetic.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{w}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Uniform on {0, ..., 9}, same as next(10).
 * int a = tgen::wnext<int>(10, 0);
 * // Biased toward larger integers in {0, ..., 9}.
 * int b = tgen::wnext<int>(10, 2);
 * ```
 *
 * @fn wnext(T right, int w);
 */


/**
 * @ingroup base
 * @brief Returns a skewed random number in range.
 *
 * @tparam T Arithmetic type, same as for @tt{tgen::next}.
 *
 * @param left Left endpoint of the range.
 * @param right Right endpoint of the range.
 * @param w Skew parameter.
 *
 * @return A value in @tt{[@pname{left}, @pname{right}]} with bias controlled by @pname{w}.
 *
 * @note For floating-point types, the underlying uniform sample uses
 *       @tt{std::uniform_real_distribution} (@tt{[@pname{left}, @pname{right})} in C++),
 *       equivalent to the closed interval because the right endpoint has probability zero.
 *
 * See @tt{tgen::wnext} for more details.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{w}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Uniform from 1 to 10.
 * int x = tgen::wnext<int>(1, 10, 0);
 * // Skewed toward 10.
 * int y = tgen::wnext<int>(1, 10, 3);
 * ```
 *
 * @fn wnext(T left, T right, int w);
 */


/**
 * @ingroup base
 * @brief Sampler for repeated draws from a fixed weighted distribution.
 *
 * Builds, in @tt{O(n)} time, a structure that produces independent
 * indices @tt{i} in @tt{[0, n - 1]} with probability proportional to
 * @tt{distribution[i]}, in @tt{O(1)} per draw.
 *
 * Internally uses the
 * <a href="https://en.wikipedia.org/wiki/Alias_method">alias method</a>.
 * The internal weight type is selected from the input type @tt{T}:
 *
 * - if @tt{T} is integral (@primitive{int}, @primitive{long long}, ...), all
 *   arithmetic is performed exactly in @tt{@type{unsigned} __int128}, so
 *   distributions summing to nearly @tt{2^128} are handled with no loss;
 * - if @tt{T} is floating-point (@primitive{float}, @primitive{double}, ...),
 *   arithmetic is performed in @tt{@type{double}}, with the small relative
 *   rounding error inherent to floating-point sums.
 *
 * If only a single index is needed, prefer @tt{tgen::next_by_distribution}. To draw
 * @tt{k} indices in one call, prefer @tt{tgen::many_by_distribution}. Use
 * @tt{tgen::weighted_sampler} directly when many independent draws from the
 * same distribution are needed but they cannot all be generated at once
 * (for example, when the next draw depends on previous draws).
 *
 * ### Examples
 *
 * ```cpp
 * // Build the sampler once, draw many times. Integer weights.
 * tgen::weighted_sampler sampler(std::vector<int>{1, 3, 6});
 * for (int i = 0; i < 100; ++i)
 *     std::cout << sampler.next() << " ";
 * // Prints e.g. "2 1 2 0 2 1 1 2 2 1 2 2 1 2 2 ...".
 *
 * // Fractional probabilities also work.
 * tgen::weighted_sampler probs(std::vector<double>{0.1, 0.3, 0.6});
 * size_t idx = probs.next();
 * ```
 *
 * @struct weighted_sampler;
 */


/**
 * @brief Creates a weighted sampler from a probability distribution.
 *
 * @tparam T Arithmetic type of the weights.
 *
 * @param distribution Non-negative weights.
 *
 * The probability of drawing index @tt{i} is @tt{@pname{distribution}[i] / sum(@pname{distribution})}.
 *
 * @throws std::runtime_error if @pname{distribution} is invalid.
 *
 * @warning For integral @tt{T}, assumes that the sum of @pname{distribution}
 *          fits in type @tt{@type{unsigned} __int128}.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{distribution}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Twice as likely to draw index 1 as index 0.
 * tgen::weighted_sampler sampler({1, 2});
 *
 * // Same idea, expressed as fractional probabilities.
 * tgen::weighted_sampler probs({1.0 / 3, 2.0 / 3});
 * ```
 *
 * @fn weighted_sampler::weighted_sampler(const std::vector<T> &distribution);
 */


/**
 * @brief Generates a random index with probability proportional to the
 *        distribution.
 *
 * @return An index @tt{i} in @tt{[0, |@pname{distribution}| - 1]} with
 *         probability @tt{@pname{distribution}[i] / sum(@pname{distribution})}.
 *
 * Indices with weight @tt{0} are never returned.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * tgen::weighted_sampler sampler({1, 1000});
 * // Probability of returning "1" is 1000 times that of "0".
 * int idx = sampler.next();
 * ```
 *
 * @fn weighted_sampler::next() const;
 */





/**
 * @ingroup base
 * @brief Returns random index with given probabilities.
 *
 * @param distribution Probability distribution.
 *
 * @return @tt{i} in @tt{[0, @pname{distribution}.size()-]} with probability proportional to
 *         @tt{@pname{distribution}[i]}.
 *
 * @warning For integral @tt{T}, assumes that the sum of @pname{distribution}
 *          fits in type @tt{@type{unsigned} __int128}.
 *
 * If many indices are needed from the same distribution, prefer
 * @ref many_by_distribution, or build a @ref tgen::weighted_sampler once and
 * call @ref weighted_sampler::next repeatedly.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{distribution}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * // 0 or 1; 1000 times more likely to generate 1.
 * int value = tgen::next_by_distribution({1, 1000});
 * ```
 *
 * @fn next_by_distribution(const std::vector<T> &distribution);
 */


/**
 * @ingroup base
 * @brief Returns many random indices with given probabilities.
 *
 * @param k Number of indices to be generated.
 * @param distribution Probability distribution.
 *
 * @return An @tt{@namespace{std}::@type{vector}} of size @pname{k} with: @tt{i} in @tt{[0, @pname{distribution}.size()-]}
 *         with probability proportional to @tt{@pname{distribution}[i]}.
 *
 * @warning Assumes that the sum of @pname{distribution} fits in type @tt{@type{unsigned} __int128}.
 *
 * Internally builds a @ref tgen::weighted_sampler and calls
 * @ref weighted_sampler::next @pname{k} times.
 *
 * #### Complexity
 *
 * @tt{O(@pname{k} + |@pname{distribution}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * // 1'000'000 values that are 0 or 1; 1000 times more likely to generate 1.
 * std::vector<int> values = tgen::many_by_distribution(1e6, {1, 1000});
 * ```
 *
 * @fn many_by_distribution(int k, const std::vector<T> &distribution);
 */


/**
 * @ingroup base
 * @brief Shuffles range inplace, for random_access_iterator.
 *
 * @param first First iterator of range.
 * @param last First iterator outside of range.
 *
 * Shuffles @tt{[@pname{first}, @pname{last})} uniformly inplace. Works for
 * @texttt{@namespace{std}::@type{vector}}, @texttt{@namespace{std}::@type{string}}, etc, but not
 * @texttt{@namespace{std}::@type{set}}. For those, use @tt{tgen::shuffled(@pname{container})}.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{last} - @pname{first}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * std::vector<int> v = {1, 2, 3, 4, 5};
 * tgen::shuffle(v.begin(), v.end());
 * ```
 *
 * @fn shuffle(It first, It last);
 */


/**
 * @ingroup base
 * @brief Shuffles a container.
 *
 * @param container Container to be shuffled.
 *
 * Works for containers and @texttt{@namespace{std}::@type{initializer_list}}. If @pname{container} is ordered
 * (@texttt{@namespace{std}::@type{set}}, etc) or @texttt{@namespace{std}::@type{initializer_list}}, returns a
 * @texttt{@namespace{std}::@type{vector}} (implemented in a different function).
 *
 * @return The shuffled container.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{container}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * std::vector<int> st = {1, 2, 3, 4, 5};
 * st = tgen::shuffled(st);
 * st = tgen::shuffled({1, 2, 3});
 * st = tgen::shuffled(std::set<int>({1, 2, 3}));
 * ```
 *
 * @fn shuffled(const C &container);
 */


/**
 * @ingroup base
 * @brief Chooses a random element from an iterator range.
 *
 * @param first First iterator of range.
 * @param last First iterator outside of range.
 *
 * @return A uniformly random element from the range @tt{[@pname{first}, @pname{last})}.
 *
 * #### Complexity
 *
 * @tt{O(1)} for random_access_iterator, @tt{O(|@pname{last} - @pname{first}|)} otherwise.
 *
 * #### Examples
 *
 * ```cpp
 * std::set<int> st = {1, 2, 3, 4, 5};
 * int value = tgen::pick(st.begin(), st.end());
 * ```
 *
 * @fn pick(It first, It last);
 */


/**
 * @ingroup base
 * @brief Chooses a random element from container.
 *
 * @param container Container to choose from.
 *
 * Also works with @texttt{@namespace{std}::@type{initializer_list}}.
 *
 * @return A uniformly random element from @pname{container}.
 *
 * #### Complexity
 *
 * @tt{O(1)} for random_access_iterator, @tt{O(|@pname{container}|)} otherwise.
 *
 * #### Examples
 *
 * ```cpp
 * std::vector<int> v = {1, 2, 3, 4, 5};
 * int value = tgen::pick(v);
 * ```
 *
 * @fn pick(const C &container);
 */


/**
 * @ingroup base
 * @brief Chooses a random element with given probabilities.
 *
 * @param container Container to choose from.
 * @param distribution Probability distribution.
 *
 * Also works with @texttt{@namespace{std}::@type{initializer_list}}.
 *
 * @return For @tt{i} in @tt{[0, @pname{container}.size()-1]}, @tt{@pname{container}[i]} with probability
 *         proportional to @tt{@pname{distribution}[i]}.
 *
 * @warning For integral @tt{T}, assumes that the sum of @pname{distribution}
 *          fits in type @tt{@type{unsigned} __int128}.
 *
 * #### Complexity
 *
 * @tt{O(1)} for random_access_iterator, @tt{O(|@pname{container}|)} otherwise.
 *
 * #### Examples
 *
 * ```cpp
 * // Generates chars with custom odds.
 * char value = tgen::pick_by_distribution({'a', 'b', 'c'}, {1, 2, 3});
 * ```
 *
 * @fn pick_by_distribution(const C &container, std::vector<T> distribution);
 * @fn pick_by_distribution(const C &container, const std::initializer_list<T> &distribution);
 */


/**
 * @ingroup base
 * @brief Chooses elements from container, as in a subsequence fixed length.
 *
 * @param container Container to choose from.
 * @param k Number of elements to be chosen.
 *
 * Also works with @texttt{@namespace{std}::@type{initializer_list}}.
 *
 * @return A uniformly random subsequence of length @pname{k}.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{container}|)}.
 *
 * #### Examples
 *
 * ```cpp
 * std::vector<int> v = {1, 2, 3, 4, 5};
 * v = tgen::choose(v, 3); // Chooses 3 elements from v.
 * ```
 *
 * @fn choose(const C &container, int k);
 */





/**
 * @ingroup base
 * @brief Distinct generator for integral ranges.
 *
 * ### Examples
 *
 * ```cpp
 * // Prints 3 distinct numbers from 1 to 10, uniformly at random.
 * tgen::distinct_range u(1, 10);
 * std::cout << u.gen() << " " << u.gen() << " " << u.gen() << std::endl;
 * ```
 *
 * @struct distinct_range;
 */


/**
 * @brief Creates distinct generator for values in given range.
 *
 * @param left Left endpoint of the range.
 * @param right Right endpoint of the range.
 *
 * The generator will generate values in @tt{[@pname{l}, @pname{r}]}.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates a generator for distinct nubers from 5 to 10.
 * auto u = tgen::distinct_range(5, 10);
 * ```
 *
 * @fn distinct_range::distinct_range(T left, T right);
 */


/**
 * @brief Returns the number of values left to generate.
 *
 * @return The number of values left to generate.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints current size of distinct generator.
 * tgen::distinct_range u(5, 10);
 * u.gen(), u.gen();
 * std::cout << u.size() << std::endl; // Prints "4".
 * ```
 *
 * @fn distinct_range::size();
 */


/**
 * @brief Generates a distinct random value in the defined range.
 *
 * @return A value in the given range that has not been generated before, uniformly at random.
 *
 * @throws std::runtime_error if there no more values to generate.
 *
 * #### Complexity
 *
 * @tt{O(log(n))} for the @tt{n}-th call of @tt{gen}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints 3 distinct numbers from 1 to 10, uniformly at random.
 * tgen::distinct_range u(1, 10);
 * std::cout << u.gen() << " " << u.gen() << " " << u.gen() << std::endl;
 * ```
 *
 * @fn distinct_range::gen();
 */


/**
 * @brief Generates a list of several distinct values.
 *
 * @return A uniformly random @ref tgen::list::value with @pname{size}
 *         distinct values from the range.
 *
 * @throws std::runtime_error if there are not enough values to generate.
 *
 * #### Complexity
 *
 * The same as @pname{size} calls to @ref distinct_range::gen.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints 3 distinct numbers from 1 to 10, uniformly at random.
 * std::cout << tgen::distinct_range(1, 10).gen_list(3) << std::endl;
 * ```
 *
 * @fn distinct_range::gen_list(int size);
 */


/**
 * @brief Generates all distinct values left to generate.
 *
 * @return A uniformly random @ref tgen::list::value with all
 *         distinct values from the range that have not been generated yet.
 *
 * #### Complexity
 *
 * The same as calling @ref distinct_range::gen until there are no more distinct values.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints all numbers from 1 to 10 in a uniformly random order.
 * std::cout << tgen::distinct_range(1, 10).gen_all() << std::endl;
 * ```
 *
 * @fn distinct_range::gen_all();
 */





/**
 * @ingroup base
 * @brief Distinct generator for containers.
 *
 * ### Examples
 *
 * ```cpp
 * // Prints 3 distinct from the set.
 * std::set<int> s = {3, 5, 9};
 * tgen::distinct_container u(s);
 * std::cout << u.gen() << " " << u.gen() << " " << u.gen() << std::endl;
 * ```
 *
 * @struct distinct_container;
 */


/**
 * @brief Creates distinct generator for elements of the given container.
 *
 * @param container Container.
 *
 * The generator will generate distinct elements from container.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates a generator distinct elements from s.
 * std::set<int> s = {3, 5, 9};
 * auto u = tgen::distinct_container(s);
 * ```
 *
 * @fn distinct_container::distinct_container(const C &container);
 */


/**
 * @brief Returns the number of elements left to generate.
 *
 * @return The number of elements left to generate.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints current size of distinct generator.
 * std::set<int> s = {3, 5, 9};
 * tgen::distinct_container u(s);
 * u.gen();
 * std::cout << u.size() << std::endl; // Prints "2".
 * ```
 *
 * @fn distinct_container::size();
 */


/**
 * @brief Generates a distinct random element from the container.
 *
 * @return An element from the container that has not been generated before, uniformly at random.
 *
 * @throws std::runtime_error if there no more elements to generate.
 *
 * #### Complexity
 *
 * @tt{O(log(n))} for the @tt{n}-th call of @tt{gen}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints 3 distinct from the set.
 * std::set<int> s = {3, 5, 9};
 * tgen::distinct_container u(s);
 * std::cout << u.gen() << " " << u.gen() << " " << u.gen() << std::endl;
 * ```
 *
 * @fn distinct_container::gen();
 */


/**
 * @brief Generates a list of several distinct elements.
 *
 * @return A uniformly random @ref tgen::list::value with @pname{size}
 *         distinct elements from the container.
 *
 * @throws std::runtime_error if there are not enough elements to generate.
 *
 * #### Complexity
 *
 * The same as @pname{size} calls to @ref distinct_container::gen.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints 3 distinct elements from s, uniformly at random.
 * std::set<int> s = {1, 2, 5, 7, 9};
 * std::cout << tgen::distinct_container(s).gen_list(3) << std::endl;
 * ```
 *
 * @fn distinct_container::gen_list(int size);
 */


/**
 * @brief Generates all distinct elements left to generate.
 *
 * @return A uniformly random @ref tgen::list::value with all
 *         distinct elements from the container that have not been generated yet.
 *
 * #### Complexity
 *
 * The same as calling @ref distinct_container::gen until there are no more distinct values.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints all elements from s in a uniformly random order.
 * std::set<int> s = {1, 2, 5, 7, 9};
 * std::cout << tgen::distinct_container(s).gen_all() << std::endl;
 * ```
 *
 * @fn distinct_container::gen_all();
 */





/**
 * @ingroup base
 * @brief Distinct generator for discrete uniform functions.
 *
 * ### Examples
 *
 * ```cpp
 * // Prints 10 random distinct strings.
 * std::cout << tgen::str("[a-z]{5}").distinct().gen_list(10) << std::endl;
 *
 * // Prints all primes in [1, 10], in order.
 * std::cout << tgen::distinct(tgen::math::gen_prime, 1, 10).gen_all().sort() << std::endl;
 *
 * // Prints some random parenthesis lists.
 * std::cout << tgen::distinct(tgen::misc::gen_parenthesis, 6).gen_list(5) << std::endl;
 *
 * // Prints 5 random square numbers in [1, 1e4].
 * std::cout << tgen::distinct(
 *     [&]() {
 *         int x = tgen::next(1, 100);
 *         return x * x;
 *     }).gen_list(5) << std::endl;
 * ```
 *
 * @struct distinct;
 */


/**
 * @brief Generates a distinct generator of a discrete uniform function.
 *
 * @tparam Func Automatically set to the function type.
 *
 * @param func The function.
 * @param args Arguments for the function.
 *
 * @pre Return type of @pname{func} must have less-than operator overload (@tt{operator<}). <br>
 *      The function must be **uniform** on its image (every value in the function's image
 *      must have the same probability of being returned).
 *
 * #### Examples
 *
 * ```cpp
 * // Generates distinct square numbers in [1, 1e4].
 * auto squares = tgen::distinct(
 *     [&](int l, int r) {
 *         int x = tgen::next(l, r);
 *         return x * x;
 *     }, 1, 1e2);
 * // Generates distinct generator for prime numbers in [1, 100].
 * auto primes = tgen::distinct(tgen::math::gen_prime, 1, 100);
 * ```
 *
 * @fn distinct::distinct(Func func, Args... args);
 */


/**
 * @brief Generates a distinct value.
 *
 * @tparam Func Automatically set to the function type.
 *
 * @return A new value that has not been generated before, uniformly at random.
 *
 * @throws std::runtime_error if there are probably (with probability at least @tt{1 - 10^(-18)}) no
 *         more distinct values to generate.
 *
 * #### Complexity
 *
 * @tt{O(T * log k + log^2 k)} amortized expected, if the function runs in @tt{O(T)} time
 * and @tt{k} values are to be generated in total.
 *
 * Reference:
 * - <a href="https://en.wikipedia.org/wiki/Coupon_collector%27s_problem">Coupon collector's problem</a>.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints some random distinct strings.
 * auto g = tgen::str("[a-z]{10}").distinct();
 * for (int i = 0; i < 10; ++i)
 *     std::cout << g.gen() << std::endl;
 *
 * // Generates some random distinct primes in [1, 100].
 * auto gp = tgen::distinct(tgen::math::gen_prime, 1, 100);
 * for (int i = 0; i < 10; ++i)
 *     std::cout << gp.gen() << std::endl;
 * ```
 *
 * @fn distinct::gen();
 */


/**
 * @brief Generates a list of several distinct values.
 *
 * @param size Size of the list to be generated.
 *
 * @return A uniformly random @ref tgen::list::value with @pname{size}
 *         distinct values from the function with the given arguments.
 *
 * @throws std::runtime_error if there are not enough values to generate.
 *
 * #### Complexity
 *
 * The same as @pname{size} calls to @ref distinct::gen.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints 10 random distinct strings.
 * std::cout << tgen::str("[a-z]{5}").distinct().gen_list(10) << std::endl;
 * ```
 *
 * @fn distinct::gen_list(int size);
 */


/**
 * @brief Checks if there is nothing left to generate.
 *
 * @return If there is probably (with probability at least @tt{1 - 10^(-18)}) no value that has not been generated yet.
 *
 * #### Complexity
 *
 * The same as a call to @ref distinct::gen.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints all primes in [1, 10].
 * auto g = tgen::distinct(tgen::math::gen_prime, 1, 10);
 * while (!g.empty()) std::cout << g.gen() << std::endl;
 * ```
 *
 * @fn distinct::empty();
 */


/**
 * @brief Generates all distinct values left to generate.
 *
 * @return A uniformly random @ref tgen::list::value with all
 *         distinct values from the function with the given arguments
 *         that have not been generated yet.
 *
 * #### Complexity
 *
 * The same as calling @ref distinct::gen until there are no more distinct values.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints all primes in [1, 10].
 * std::cout << tgen::distinct(tgen::math::gen_prime, 1, 10).gen_all() << std::endl;
 * ```
 *
 * @fn distinct::gen_all();
 */





/**
 * @ingroup base
 * @brief Base class for generators (should not be instantiated).
 *
 * @struct gen_base;
 */


/**
 * @brief Generates a list of several generation calls.
 *
 * @tparam Gen Automatically set to the given type.
 *
 * @param size Size of the list to be generated.
 * @param args Arguments for the @tt{tgen::@type{Gen}::gen} call.
 *
 * @return A @ref tgen::list::value with @pname{size}
 *         calls to @tt{tgen::@type{Gen}::gen(@pname{args}...)}.
 *
 * #### Complexity
 *
 * @pname{size} times the complexity of one @tt{tgen::@type{Gen}::gen(@pname{args}...)} call.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates and prints a list of 3 calls to the regex string generator.
 * auto lst = tgen::str("[a-z]{%d}", 5).gen_list(3);
 * std::cout << lst << std::endl;
 * ```
 *
 * @fn gen_base::gen_list(int size, Args &&...args) const;
 */


/**
 * @brief Generates a random value from the valid set until a condition is met.
 *
 * @tparam Gen Automatically set to the given type.
 *
 * @param predicate Condition to be checked. Should be a function that takes in a
 *        @tt{@type{Gen}::value}, and returns a @primitive{bool}.
 * @param max_tries The maximum number of times the function will try to generate a valid value
 *        satisfying @pname{predicate}.
 * @param args Arguments for the function @tt{tgen::@type{Gen}::gen}.
 *
 * Calls @tt{tgen::@type{Gen}::gen(@pname{args}...)} until @pname{predicate} is true, at most @pname{max_tries} times.
 * If @pname{predicate} has probability @tt{p} of returning @tt{true}, then such a value
 * will be found with probability @tt{1 - (1-p)^@pname{max_tries}}.
 *
 * @return A @tt{tgen::@type{Gen}::value} found by repeatedly drawing from the generator and checking
 * @pname{predicate}.
 *
 * @throws std::runtime_error if no valid value satisfying @pname{predicate} is found after @pname{max_tries}
 *         tries.
 *
 * #### Complexity
 *
 * @tt{O(T(n) * (1 / p))} expected, if @tt{@type{Gen}::value} runs in @tt{O(T(n))} time, and @pname{predicate} has probability
 * @tt{p} of returning @tt{true}.
 * @tt{O(T(n) * @pname{max_tries})}, worst case.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints a list of 10 distinct ints from 1 to 10 such that the first element is smaller than the last.
 * std::cout <<
 *     tgen::list<int>(10, 1, 10)
 *         .all_different()
 *         .gen_until([](const auto &seq) { return seq[0] < seq[9]; }, 100)
 * 	 << std::endl;
 *
 * // Prints a random odd permutation of size 5.
 * std::cout <<
 *     tgen::permutation(5)
 *         .gen_until([](const auto &perm) { return perm.parity() == -1; }, 100)
 * 	 << std::endl;
 * 
 * // Prints a random odd permutation of size 5 with one cycle.
 * std::cout <<
 *     tgen::permutation(5).cycles({5})
 *         .gen_until([](const auto &perm) { return perm.parity() == -1; }, 100)
 * 	 << std::endl;
 *
 * // Prints a string of 10 letters that starts and ends with the same character.
 * std::cout <<
 *     tgen::str("[a-zA-Z]{10}")
 *         .gen_until([](const auto &s) { return s[0] == s[9]; }, 100)
 * 	 << std::endl;
 * ```
 *
 * @fn gen_base::gen_until(Pred predicate, int max_tries, Args &&...args) const;
 */


/**
 * @brief Creates distinct generator for current generator.
 *
 * @tparam Gen Automatically set to the given type.
 *
 * @param args Arguments to the @tt{tgen::@type{Gen}::gen} call.
 *
 * @return The @ref distinct generator that calls @tt{tgen::@type{Gen}::gen} with the given arguments.
 *
 * #### Complexity
 *
 * Linear.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates distinct generator of strings with 5 lowercase letters.
 * auto g = tgen::str("[a-z]{%d}", 5).distinct();
 * // Creates distinct generator of permutations with cycles of sizes 1 and 2.
 * auto u = tgen::permutation(3).cycles({1, 2}).distinct();
 * ```
 *
 * @fn gen_base::distinct(Args &&...args) const;
 */





/**
 * @ingroup base
 * @brief Base class for generator values (should not be instantiated).
 *
 * @struct gen_value_base;
 */


/**
 * Comparator for generator values.
 *
 * @tparam Val Automatically set to the given type.
 *
 * @param rhs Right-hand side of the comparison.
 *
 * @return Whether this generator value is less than @pname{rhs}.
 *
 * Uses @tt{@pname{Val}::to_std} for the comparison.
 *
 * #### Complexity
 *
 * Linear.
 *
 * #### Examples
 *
 * ```cpp
 * // Checks if one string is lexicographically smaller than the other.
 * std::cout << (tgen::str::value("aba") < tgen::str::value("abc")) << std::endl; // Prints "1".
 * ```
 *
 * @fn gen_value_base::operator<(const Val &rhs) const;
 */

};

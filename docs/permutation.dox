#include "../single_include/tgen.h"

namespace tgen {

/**
 * @defgroup permutation Permutations
 * @brief Generation of permutations.
 *
 * ### Examples
 *
 * Prints a random 1-based permutation of size 10 that starts with 2.
 *
 * ```cpp
 * std::cout << tgen::permutation(10).fix(0, 1).gen().print_1_based() << std::endl;
 * ```
 *
 * ```
 * 2 7 10 4 3 9 1 5 8 6
 * ```
 *
 * Prints a random permutation of size 5 with only one cycle.
 *
 * ```cpp
 * std::cout << tgen::permutation(5).cycles({5}).gen() << std::endl;
 * ```
 *
 * ```
 * 1 4 3 0 2
 * ```
 *
 * Prints the inverse of a random odd permutation of size 5.
 *
 * ```cpp
 * std::cout <<
 *     tgen::permutation(5)
 *         .gen_until([](const auto &perm) { return perm.parity() == -1; }, 100)
 *     .inverse()
 *   << std::endl;
 * ```
 *
 * ```
 * 4 2 3 1 0
 * ```
 */





/**
 * @ingroup permutation
 * @brief Permutation generator.
 *
 * Defines a set of permutations, subject to restrictions.
 *
 * A uniformly random @tt{tgen::permutation::value}
 * from this set of permutations (that satisfies the restrictions) can be
 * generated with @tt{tgen::permutation::gen}.
 *
 * @struct permutation;
 */


/**
 * @brief Creates permutation generator defined by size.
 *
 * @param size Size of the permutation.
 *
 * #### Examples
 *
 * ```cpp
 * // Permutations of size 10.
 * auto perm_gen = tgen::permutation(10);
 * ```
 *
 * @fn permutation::permutation(int size);
 */


/**
 * @brief Restricts generator s.t. value at index is fixed.
 *
 * @param idx Index.
 * @param val Value.
 *
 * #### Examples
 *
 * ```cpp
 * // Permutations of size 10 that start with 1.
 * auto perm_gen = tgen::permutation(10).fix(0, 1);
 * ```
 *
 * @fn permutation::fix(int idx, int val);
 */


/**
 * @brief Restricts generator s.t. cycle sizes are fixed.
 *
 * @param cycle_sizes Sizes of cycles.
 *
 * The sizes of cycles of the generated permutation will be @pname{cycle_sizes}.
 *
 * #### Examples
 *
 * ```cpp
 * // Permutations of size 5 with only one cycle.
 * auto perm_gen = tgen::permutation(5).cycles({5}).gen();
 * ```
 *
 * @fn permutation::cycles(const std::vector<int> &cycle_sizes);
 */


/**
 * @brief Generates a uniformly random value from the set of valid permutations.
 *
 * @return A uniformly random @tt{tgen::permutation::value} from the set of valid permutations, given the added restrictions.
 *
 * @throws std::runtime_error if there is no valid permutation satisfying all added restrictions.
 *
 * #### Complexity
 *
 * @tt{O(n)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Generates and prints a random permutation of size 5.
 * auto val = tgen::permutation(5).gen();
 * std::cout << val << std::endl;
 * ```
 *
 * @fn permutation::gen() const;
 */





/**
 * @ingroup permutation
 *
 * @brief Permutation value.
 *
 * It can be printed through @tt{@namespace{std}::cout}.
 *
 * @struct permutation::value;
 */


/**
 * @brief Creates a permutation value from a @texttt{@namespace{std}::@type{vector}}.
 *
 * @param vec The @texttt{@namespace{std}::@type{vector}} representing the permutation.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates and prints a permutation from a std::vector.
 * std::vector<int> v = {0, 1, 2};
 * tgen::permutation::value val(v);
 * std::cout << val << std::endl; // Prints "0 1 2".
 *
 * // Also works with conversions, and std::initializer_list<T>.
 * val = {1, 0};
 * std::cout << val.print_1_based() << std::endl; // Prints "2 1".
 * ```
 *
 * @fn permutation::value::value(const std::vector<int> &vec);
 */


/**
 * @brief Returns the size of the permutation value.
 *
 * @return The size (number of elements) of the permutation value.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints the size of a permutation.
 * tgen::permutation::value val = {0, 1, 2};
 * std::cout << val.size() << std::endl; // Prints "3".
 * ```
 *
 * @fn permutation::value::size();
 */


/**
 * @brief Returns the image at some position of the permutation.
 *
 * @param idx Index to be accessed.
 *
 * @return The element at index @pname{idx}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints a position of a permutation.
 * tgen::permutation::value val = {2, 0, 1};
 * std::cout << val[1] << std::endl; // Prints "0".
 * ```
 *
 * @fn permutation::value::operator[](int idx) const;
 */


/**
 * @brief Parity of the permutation.
 *
 * @return @tt{+1} if the permutation is even, or @tt{-1} if the permutation is odd.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints parity of permutation.
 * tgen::permutation::value val = {2, 0, 1};
 * std::cout << val.parity() << std::endl; // Prints "1".
 * ```
 *
 * @fn permutation::value::parity();
 */


/**
 * @brief Sorts the permutation in non-decreasing order.
 *
 * #### Complexity
 *
 * @tt{O(n)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Sorts and prints a permutation.
 * tgen::permutation::value val = {2, 0, 1};
 * std::cout << val.sort() << std::endl; // Prints "0 1 2".
 * ```
 *
 * @fn permutation::value::sort();
 */


/**
 * @brief Reverses the permutation.
 *
 * #### Complexity
 *
 * @tt{O(n)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Reverses and prints a permutation.
 * tgen::permutation::value val = {2, 0, 1};
 * std::cout << val.reverse() << std::endl; // Prints "1 0 2".
 * ```
 *
 * @fn permutation::value::reverse();
 */


/**
 * @brief Inverse of the permutation.
 *
 * The inverse of the permutation @tt{p} is another @tt{pi} such that @tt{pi[p[i]] = p[pi[i]] = i}.
 *
 * #### Complexity
 *
 * @tt{O(n)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints inverse of permutation.
 * tgen::permutation::value val = {2, 0, 1};
 * std::cout << val.inverse() << std::endl; // Prints "1 2 0".
 * ```
 *
 * @fn permutation::value::inverse();
 */


/**
 * @brief Sets separator for printing.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints a permutation, separated by commas.
 * tgen::permutation::value val = {2, 0, 1};
 * std::cout << val.separator(',') << std::endl; // Prints "2,0,1".
 * ```
 *
 * @fn permutation::value::separator(char sep);
 */


/**
 * @brief Sets that printed values are 1-based.
 *
 * This only affects streaming (@texttt{@namespace{std}::@type{cout}} and friends). Stored values,
 * @tt{operator[]}, and @tt{to_std()} stay 0-based. For a 1-based
 * @texttt{@namespace{std}::@type{vector}}, use @tt{to_std_1_based()}.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints a 1-based permutation; to_std() remains 0-based.
 * tgen::permutation::value val = {2, 0, 1};
 * std::cout << val.print_1_based() << std::endl; // Prints "3 1 2".
 * auto zero_based = val.to_std();           // {2, 0, 1}
 * auto one_based = val.to_std_1_based();    // {3, 1, 2}
 * ```
 *
 * @fn permutation::value::print_1_based();
 */


/**
 * @brief Shuffles the permutation.
 *
 * #### Complexity
 *
 * @tt{O(n)}.
 *
 * #### Examples
 *
 * ```cpp
 * tgen::permutation::value val = {2, 0, 1};
 * std::cout << val.shuffle() << std::endl;
 * ```
 *
 * @fn permutation::value::shuffle();
 */


/**
 * @brief Returns a uniformly random element.
 *
 * @return A uniformly random element from the permutation.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * tgen::permutation::value val = {2, 0, 1};
 * std::cout << val.pick() << std::endl;
 * ```
 *
 * @fn permutation::value::pick() const;
 */


/**
 * @brief Returns a random element from the permutation with given probabilities.
 *
 * @param distribution Probability distribution.
 *
 * @return A random element from the permutation, chosen with probability proportional to @tt{@pname{distribution}}.
 *
 * @warning For integral @tt{Dist}, assumes that the sum of @pname{distribution}
 *          fits in type @tt{@type{unsigned} __int128}.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * tgen::permutation::value val = {2, 0, 1};
 * std::cout << val.pick_by_distribution({1, 2, 3}) << std::endl;
 * ```
 *
 * @fn permutation::value::pick_by_distribution(const std::vector<Dist> &distribution) const;
 */


/**
 * @brief Prints the permutation to an output stream.
 *
 * The entries are printed with one space as a separator by default,
 * and with no end of line.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints a permutation.
 * std::cout << tgen::permutation::value({2, 0, 1}) << std::endl; // Prints "2 0 1".
 * ```
 *
 * @fn permutation::value::operator<<(std::ostream &out, const value &val);
 */


/**
 * @brief Converts the permutation to a @texttt{@namespace{std}::@type{vector}}.
 *
 * Returns 0-based values. Unaffected by @tt{print_1_based()}.
 * For a 1-based export, use @tt{to_std_1_based()}.
 *
 * @return A @texttt{@namespace{std}::@type{vector}} representing the permutation.
 *
 * #### Examples
 *
 * ```cpp
 * // Convoluted way to reverse a permutation.
 * std::vector<int> v = {2, 0, 1};
 * v = tgen::permutation::value(v).reverse().to_std();
 * // v = {1, 0, 2}.
 * ```
 *
 * @fn permutation::value::to_std();
 */


/**
 * @brief Converts the permutation to a 1-based @texttt{@namespace{std}::@type{vector}}.
 *
 * Each element is increased by one. Unaffected by @tt{print_1_based()}.
 *
 * @return A 1-based @texttt{@namespace{std}::@type{vector}} representing the permutation.
 *
 * #### Examples
 *
 * ```cpp
 * auto one_based = tgen::permutation::value({2, 0, 1}).to_std_1_based();
 * // one_based = {3, 1, 2}.
 * ```
 *
 * @fn permutation::value::to_std_1_based();
 */

};

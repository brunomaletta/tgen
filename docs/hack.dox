#include "../single_include/tgen.h"

namespace tgen::hack {

/**
 * @defgroup hack Hacks
 * @brief Adversarial generation for specific problems.
 *
 * ### Examples
 *
 * ```cpp
 * // Creates values that force collision on std::unordered_set.
 * std::vector<long long> unord_hack = tgen::hack::std_unordered(1e6);
 *
 * // Creates queries that force worst-case for Mo's algorithm.
 * std::vector<std::pair<int, int>> mo_hack = tgen::hack::mo_worst_case(1e6, 1e6);
 *
 * // Mask for XOR-hashing std::mt19937 outputs to zero.
 * std::vector<bool> xor_mask = tgen::hack::mt19937_xor_hash<int>();
 *
 * // Mask for XOR-hashing std::mt19937_64 outputs to zero.
 * std::vector<bool> xor_mask_64 = tgen::hack::mt19937_xor_hash<long long>();
 *
 * // Hack for segment tree beats: initial array and update list.
 * auto [arr, updates] = tgen::hack::segment_tree_beats_worst_case(3, 146);
 * ```
 */


/**
 * @ingroup hack
 * @brief Returns the prefix of the infinite word "abacabad...".
 *
 * @param n Length of the prefix.
 *
 * @return A string with the prefix of length @pname{n} of @tt{"abacabad..."}.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints "abacaba".
 * std::cout << tgen::hack::abacaba(7) << std::endl;
 * ```
 *
 * @fn abacaba(int n);
 */


/**
 * @ingroup hack
 * @brief Returns two strings that force polynomial hash collision for power-of-two mod.
 *
 * Computes two strings that have the same polynomial hash for any base and power-of-two mod (up to @tt{2^64}). <br>
 * Characters are in @tt{[a, b]}.
 *
 * @return A @tt{@namespace{std}\::pair} with the colliding strings.
 *
 * Reference:
 * - <a href="https://codeforces.com/blog/entry/60442">On the mathematics behind rolling hashes and anti-hash
 *   tests</a>: Thue–Morse sequence: Hashing with unsigned overflow (p = 2^64, q arbitrary).

 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints unsigned polynomial hash hack.
 * std::cout << tgen::print(tgen::hack::unsigned_polynomial_hash()) << std::endl;
 * ```
 *
 * @fn unsigned_polynomial_hash();
 */


/**
 * @ingroup hack
 * @brief Returns two strings that force polynomial hash collision given base and mod.
 *
 * @param alphabet_size Alphabet size.
 * @param base Base.
 * @param mod Mod.
 *
 * @pre
 * @tt{0 < @pname{base} < @pname{mod}}
 *
 * Computes two strings that have the same polynomial hash for given base and mod. <br>
 * Characters are in @tt{[a, a + @pname{alphabet_size})}. The larger the alphabet, the smaller the colliding strings.
 *
 * @return A @tt{@namespace{std}\::pair} with the colliding strings.
 *
 * Reference:
 * - <a href="https://codeforces.com/blog/entry/60442">On the mathematics behind rolling hashes and anti-hash
 *   tests</a>: Composition-attack: Multiple hashes.
 *
 * #### Complexity
 *
 * @tt{O(sqrt(@pname{mod}) log @pname{mod})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints polynomial hash hack.
 * std::cout << tgen::print(tgen::hack::polynomial_hash(2, 31, 1e9+7), '\n') << std::endl;
 * ```
 *
 * @fn polynomial_hash(int alphabet_size, int base, int mod);
 */


/**
 * @ingroup hack
 * @brief Returns two strings that force polynomial hash collision given bases and mods.
 *
 * @param alphabet_size Alphabet size.
 * @param bases Bases.
 * @param mods Mods.
 *
 * @pre
 * @tt{|@pname{bases}| = |@pname{mods}| <= 2}. <br>
 * @tt{0 < @pname{bases}[i] < @pname{mods}[i]}.
 *
 * Computes two strings that have the same polynomial hash for given bases and mods,
 * up to 2 (base, mod) pairs. <br>
 * Characters are in @tt{[a, a + @pname{alphabet_size})}. The larger the alphabet, the smaller the colliding strings.
 *
 * @return A @tt{@namespace{std}\::pair} with the colliding strings.
 *
 * Reference:
 * - <a href="https://codeforces.com/blog/entry/60442">On the mathematics behind rolling hashes and anti-hash
 *   tests</a>: Composition-attack: Multiple hashes.

 *
 * #### Complexity
 *
 * @tt{O(sqrt(mod) log^2 mod)}, with @tt{mod = max(@pname{mods})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints polynomial hash hack for double hash.
 * std::cout << tgen::print(tgen::hack::polynomial_hash(2, {31, 33}, {1000000007, 1000000009}), '\n') << std::endl;
 * ```
 *
 * @fn polynomial_hash(int alphabet_size, std::vector<int> bases, std::vector<int> mods);
 */


 /**
 * @ingroup hack
 * @brief List of integers that tries to force collision on @tt{@namespace{std}::@type{unordered_set}}.
 *
 * @param size Size of the list.
 *
 * Creates hack for both @tt{@namespace{std}::@type{unordered_set}} and @tt{@namespace{std}::@type{unordered_map}},
 * forcing quadratic behavior. The hack might not be effective due to differences in @tt{C++} implementations.
 *
 * @note The hack might not be effective due to differences in C++ implementations. <br>
 *       This function benefits from tgen::set_compiler and tgen::set_cpp_version information.
 *
 * #### Complexity
 *
 * @tt{O(@pname{size})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates values that force collision.
 * std::vector<long long> hack = tgen::hack::std_unordered(1e6);
 * ```
 *
 * @fn std_unordered(int size);
 */


 /**
 * @ingroup hack
 * @brief Query list that forces asymptotic worst-case for Mo's algorithm.
 *
 * @param n Size of the array operated upon.
 * @param q Number of queries to be returned.
 *
 * Forces @tt{Theta(q sqrt n)} pointer moves for any ordering.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n} log @pname{n} + @pname{q})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates queries that force worst-case for Mo.
 * std::vector<std::pair<int, int>> hack = tgen::hack::mo_worst_case(1e6, 1e6);
 * ```
 *
 * @fn mo_worst_case(int n, int q);
 */


 /**
 * @ingroup hack
 * @brief List of strings that have high cost to insert in a @tt{@namespace{std}::@type{set}}.
 *
 * @param size Total number of characters.
 *
 * Inserting these strings in a @tt{@namespace{std}::@type{set}} takes @tt{Theta(@pname{size} log(@pname{size}))}
 * time, and that is asymptotically the maximum one can achieve.
 *
 * #### Complexity
 *
 * @tt{O(@pname{size} log(@pname{size}))}.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates strings that have high cost to insert in std::set.
 * std::vector<std::string> hack = tgen::hack::string_set_worst_case(1e6);
 * ```
 *
 * @fn string_set_worst_case(int size);
 */


/**
 * @ingroup hack
 * @brief Directed weighted graph for Dijkstra with non-strict relaxation.
 *
 * @param n Number of vertices.
 *
 * @pre @tt{@pname{n} >= 3}.
 *
 * Forces @tt{Omega(2^{@pname{n}/2})} time on Dijkstra from @tt{0} if relaxation
 * uses @tt{d + w <= dist[j]} instead of @tt{<}.
 *
 * @return An @tt{egraph<int>::value} with @tt{m = 2(@pname{n} - 2)} directed edges, all with weight @tt{1}.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n})}.
 *
 * #### Examples
 *
 * ```cpp
 * auto g = tgen::hack::non_strict_relaxation_dijkstra_bug(10000);
 * ```
 *
 * @fn non_strict_relaxation_dijkstra_bug(int n);
 */


/**
 * @ingroup hack
 * @brief Directed weighted graph for Dijkstra without a stale-heap check.
 *
 * @param n Number of vertices.
 *
 * @pre @tt{@pname{n} >= 4}.
 *
 * Forces @tt{Omega(@pname{n}^2)} time on Dijkstra from @tt{0} if the heap pop
 * does not skip stale entries (@tt{if (d > dist[i]) continue}).
 *
 * @return An @tt{egraph<int>::value} with @tt{m = @pname{n} + floor(@pname{n}/2) - 3}
 *         directed edges, with weights at most @tt{@pname{n}}.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n})}.
 *
 * #### Examples
 *
 * ```cpp
 * auto g = tgen::hack::stale_heap_dijkstra_bug(300000);
 * ```
 *
 * @fn stale_heap_dijkstra_bug(int n);
 */


/**
 * @ingroup hack
 * @brief Worst-case for FIFO-SPFA.
 *
 * @param n Number of vertices.
 *
 * @pre @tt{@pname{n} >= 2}, @tt{@pname{n} even}.
 *
 * Builds two parallel chains of length @tt{k = @pname{n}/2} (upper @tt{a_1..a_k},
 * lower @tt{b_1..b_k}):
 *
 * - Upper chain @tt{a_i -> a_{i+1}}, weight @tt{1};
 * - Lower chain @tt{b_i -> b_{i+1}}, weight @tt{0};
 * - Vertical @tt{a_i -> b_i}, weight @tt{0};
 * - Cross @tt{b_i -> a_{i+1}}, weight @tt{1}.
 *
 * The upper chain reaches each @tt{a_{i+1}} with a loose estimate first; once
 * @tt{b_i} is settled on the zero-weight lower chain, the cross edge can
 * strictly improve @tt{a_{i+1}} and re-enqueue it in FIFO-SPFA.
 *
 * Forces @tt{Omega(@pname{n}^2)} time on FIFO-SPFA from vertex @tt{0} (@tt{Theta(@pname{n} * m)}.
 *
 * @return A directed @tt{tgen::egraph<int>::value} with @tt{@pname{n}} vertices and
 *         @tt{m = 2@pname{n} - 3} edges. 
 *
 * #### Complexity
 *
 * @tt{O(@pname{n})}.
 *
 * #### Examples
 *
 * ```cpp
 * auto g = tgen::hack::spfa(1e5);
 * ```
 *
 * @fn spfa(int n);
 */


/**
 * @ingroup hack
 * @brief Flow network for Edmonds-Karp and Dinitz worst-case.
 *
 * @param k Core size.
 * @param l Source and sink chain length.
 *
 * @pre @tt{@pname{k} >= 1}, @tt{@pname{l} >= 1}.
 *
 * Builds the Zadeh (1972) anti-shortest-paths network, a worst-case instance for
 * both Edmonds-Karp and Dinitz. The source is vertex @tt{0} and the sink is vertex
 * @tt{4@pname{l} + 2@pname{k} + 1}.
 *
 * @image html dinitz_worst_case.png "Zadeh anti-shortest-paths flow network" width=800
 *
 * @return A directed @tt{tgen::egraph<int>::value} with
 *         @tt{n = 4@pname{l} + 2@pname{k} + 2} vertices and
 *         @tt{m = 6@pname{l} + 4@pname{k} + @pname{k}^2 - 4} edges.
 *         Source @tt{s = 0}, sink @tt{t = 4@pname{l} + 2@pname{k} + 1}.
 *
 * References:
 * - <a href="https://codeforces.com/blog/entry/145343">Worst-Case Graphs for
 *   Maximum Flow Algorithms</a>: Shortest Augmenting Paths (Edmonds-Karp, Dinic).
 * - Norman Zadeh, "Theoretical Efficiency of the Edmonds-Karp Algorithm for
 *   Computing Maximal Flows", J. ACM 19.1 (1972).
 *
 * #### Complexity
 *
 * @tt{O(@pname{l} + @pname{k}^2)}.
 *
 * #### Examples
 *
 * ```cpp
 * std::cout << tgen::hack::dinitz_worst_case(100, 100).print_nm();
 * ```
 *
 * @fn dinitz_worst_case(int k, int l);
 */


/**
 * @ingroup hack
 * @brief Convex polygon that breaks naive rotating calipers for maximum distance.
 *
 * Returns a strictly convex polygon on which the naive rotating-calipers loop
 * (advance @tt{j} while @tt{dist(i, next(j)) > dist(i, j)}) reports a diameter
 * smaller than the true one.
 *
 * @return Six vertices of a strictly convex polygon (clockwise).
 *
 * Reference:
 * - <a href="https://codeforces.com/blog/entry/48868#comment-329438">DuX counterexample</a>
 *   to Errichto's naive maximum-distance algorithm.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * std::vector<tgen::geometry::point<double>> poly = tgen::hack::naive_rotating_calipers_max_dist_bug();
 * ```
 *
 * @fn naive_rotating_calipers_max_dist_bug();
 */


/**
 * @ingroup hack
 * @brief Mask that forces a zero XOR hash from @tt{@namespace{std}::@type{mt19937}} or
 *        @tt{@namespace{std}::@type{mt19937_64}}.
 *
 * @tparam T @tt{@primitive{int}} for @tt{@namespace{std}::@type{mt19937}}, @tt{@primitive{long long}} for
 *         @tt{@namespace{std}::@type{mt19937_64}}.
 *
 * @return A mask of length @tt{19938}.
 *
 * For any seed, if @tt{rng} is the corresponding engine and
 * @code
 * std::mt19937 rng(42);
 * int hash = 0;
 * for (bool use : tgen::hack::mt19937_xor_hash<T>()) {
 *   if (use) hash ^= rng();
 * }
 * @endcode
 * then @tt{hash = 0}.
 *
 * Reference:
 * - <a href="https://codeforces.com/blog/entry/153335">Hacking Incorrect XOR Hashing with mt19937_64</a>.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * std::mt19937 rng(seed);
 * uint32_t hash = 0;
 * for (bool use : tgen::hack::mt19937_xor_hash<int>())
 *   if (use) hash ^= rng();
 * ```
 *
 * @fn mt19937_xor_hash();
 */


/**
 * @ingroup hack
 * @brief Array and updates for worst case of segment tree beats.
 *
 * @param k Hack order (defines the size @tt{N} of the array).
 * @param q Number of updates to generate.
 *
 * @pre @tt{1 <= @pname{k} <= 7} (largest @tt{@pname{k}} with @tt{fib(2@pname{k}+1) < 10^3}).
 *
 * @return A @tt{@namespace{std}\::@type{pair}(array, updates)} that yields @tt{Theta(log^2 N)}
 *         amortized time per update.
 * 
 * - @tt{array}: initial @tt{@namespace{std}\::@type{vector}<@primitive{int}>}, length
 *   @tt{N = fib(2@pname{k}+1)^3}, entries in @tt{[0, fib(2@pname{k}+2) - 2]}.
 * - @tt{updates}: exactly @tt{@pname{q}} updates to apply in order (0-indexed,
 *   half-open intervals). Each update is a @tt{@namespace{std}\::@type{vector}<@primitive{int}>}:
 *   - @tt{\{0, l, r, x\}}: add @tt{x} on @tt{[l, r)}.
 *   - @tt{\{1, l, r, x\}}: subtract @tt{x} on @tt{[l, r)}.
 *   - @tt{\{2, l, r, x\}}: chmax @tt{x} on @tt{[l, r)}.
 *   - @tt{\{3, i, x\}}: set @tt{array[i] = x}.
 *
 * Reference:
 * - <a href="https://codeforces.com/blog/entry/149516">The Time Complexity Lower
 *   Bound for Segment Tree Beats is log^2</a>.
 *
 * #### Complexity
 *
 * @tt{O(fib(2@pname{k}+1)^3 + @pname{q})}.
 *
 * #### Examples
 *
 * ```cpp
 * auto [arr, updates] = tgen::hack::segment_tree_beats_worst_case(3, 146);
 * for (const auto &u : updates) {
 *   if (u[0] == 0)
 *     for (int i = u[1]; i < u[2]; ++i) arr[i] += u[3];
 *   else if (u[0] == 1)
 *     for (int i = u[1]; i < u[2]; ++i) arr[i] -= u[3];
 *   else if (u[0] == 2)
 *     for (int i = u[1]; i < u[2]; ++i) arr[i] = std::max(arr[i], u[3]);
 *   else if (u[0] == 3)
 *     arr[u[1]] = u[2];
 * }
 * ```
 *
 * @fn segment_tree_beats_worst_case(int k, int q);
 */


/**
 * @ingroup hack
 * @brief Tree and path queries for centroid decomposition worst case.
 *
 * Builds a tree and path queries that force @tt{Theta(log n)} centroid-tree
 * nodes per query on a correct centroid-decomposition implementation.
 *
 * The tree is a near-balanced binary tree in heap layout on @tt{0..n-1}
 * (parent @tt{i}, children @tt{2i+1} and @tt{2i+2}). Queries are random leaves
 * in the left and right subtrees of @tt{0}.
 *
 * @param n Number of vertices.
 * @param q Number of path queries.
 *
 * @pre @tt{@pname{n} >= 3}, @tt{@pname{q} >= 1}.
 *
 * @return A @tt{@namespace{std}\::@type{pair}} of a @tt{tgen::tree::value} on
 *         @pname{n} vertices and @pname{q} path queries @tt{(u, v)}.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n} + @pname{q})}.
 *
 * #### Examples
 *
 * ```cpp
 * auto [t, queries] = tgen::hack::centroid_decomposition_worst_case(100, 50);
 * std::cout << t.print_n();
 * std::cout << queries.size() << '\n';
 * for (auto [u, v] : queries)
 *   std::cout << u << ' ' << v << '\n';
 * ```
 *
 * @fn centroid_decomposition_worst_case(int n, int q);
 */


/**
 * @ingroup hack
 * @brief Tree and path queries for heavy-light decomposition worst case.
 *
 * Builds a tree and path queries that force @tt{Theta(log n)} heavy-light
 * chains per query on a correct heavy-light decomposition implementation
 * rooted at @tt{0}.
 *
 * The tree is a near-balanced binary tree in heap layout on @tt{0..n-1}
 * (parent @tt{i}, children @tt{2i+1} and @tt{2i+2}). Queries are random leaves
 * in the left and right subtrees of @tt{0}.
 *
 * @param n Number of vertices.
 * @param q Number of path queries.
 *
 * @pre @tt{@pname{n} >= 3}, @tt{@pname{q} >= 1}.
 *
 * @return A @tt{@namespace{std}\::@type{pair}} of a @tt{tgen::tree::value} on
 *         @pname{n} vertices and @pname{q} path queries @tt{(u, v)}.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n} + @pname{q})}.
 *
 * #### Examples
 *
 * ```cpp
 * auto [t, queries] =
 *     tgen::hack::heavy_light_decomposition_worst_case(1000, 500);
 * std::cout << t.print_n();
 * std::cout << queries.size() << '\n';
 * for (auto [u, v] : queries)
 *   std::cout << u << ' ' << v << '\n';
 * ```
 *
 * @fn heavy_light_decomposition_worst_case(int n, int q);
 */

} // namespace hack
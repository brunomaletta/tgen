#include "../single_include/tgen.h"

namespace tgen::hack {

/**
 * @defgroup hack Hacks
 * @brief Worse-case generation for specific problems.
 *
 * ### Examples
 *
 * ```cpp
 * // Creates values that force collision on std::unordered_set.
 * std::vector<long long> unord_hack = tgen::hack::std_unordered(1e6);
 *
 * // Creates queries that force worst-case for Mo's algorithm.
 * std::vector<std::pair<int, int>> mo_hack = tgen::hack::mo(1e6, 1e6);
 * ```
 */


 /**
 * @ingroup hack
 * @brief List of integers that tries to force collision on @tt{@namespace{std}::@type{unordered_set}}.
 *
 * @param size Size of the list.
 *
 * Creates hack for both @tt{@namespace{std}::@type{unordered_set}} and @tt{@namespace{std}::@type{unordered_map}},
 * forcing quadratic behavior. The hack might not be effective due to differences in @tt{C++} implementations.
 *
 * @note The hack might not be effective due to differences in C++ implementations. <br>
 *       This function benefits from tgen::set_compiler and tgen::set_cpp_version information.
 *
 * #### Complexity
 *
 * @tt{O(@pname{size})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates values that force collision.
 * std::vector<long long> hack = tgen::hack::std_unordered(1e6);
 * ```
 *
 * @fn std_unordered(int size);
 */


 /**
 * @ingroup hack
 * @brief Query list that tries to force asymptotic worse-case for Mo's algorithm.
 *
 * @param n Size of the array operated upon.
 * @param q Number of queries to be returned.
 *
 * The expected number of pointer moves are as follows, assuming standard implementations:
 * - For block-based Mo, assuming blocks of size @tt{b} and @tt{@pname{q} >> @pname{n} / b}:
 *   @tt{Theta(@pname{n}^2 / b + @pname{q} b)}.
 * - For Hilbert-based Mo:
 *   @tt{Theta(@pname{q} sqrt(@pname{n}))}.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n} log @pname{n})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates queries that force worst-case for Mo.
 * std::vector<std::pair<int, int>> hack = tgen::hack::mo(1e6, 1e6);
 * ```
 *
 * @fn mo(int n, int q);
 */


 /**
 * @ingroup hack
 * @brief List of strings that have high cost to insert in a @tt{@namespace{std}::@type{set}}.
 *
 * @param size Size of the list.
 *
 * Inserting these strings in a @tt{@namespace{std}::@type{set}} takes @tt{Theta(@pname{size} log(@pname{size}))}
 * time, and that is asymptotically the maximum one can achieve.
 *
 * #### Complexity
 *
 * @tt{O(@pname{size} log(@pname{size}))}.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates strings that have high cost to insert in std::set.
 * std::vector<std::string> hack = tgen::hack::string_set(1e6);
 * ```
 *
 * @fn string_set(int size);
 */

};
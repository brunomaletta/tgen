#include "../single_include/tgen.h"

namespace tgen {

/**
 * @defgroup pair Pairs
 * @brief Generation of pairs of integral types.
 *
 * ### Examples
 *
 * Prints 10 different pairs of values from 1 to n, with first <= second.
 *
 * ```cpp
 * std::cout <<
 *     tgen::pair<int>(1, n).leq().distinct().gen_list(10).separator('\n') << std::endl;
 * ```
 */





 /**
 * @ingroup pair
 * @brief Pair generator.
 *
 * Defines a set of pairs, subject to restrictions.
 *
 * A uniformly random @tt{tgen::pair::value}
 * from this set of pairs (that satisfies the restrictions) can be
 * generated with @tt{tgen::pair::gen}.
 *
 * @struct pair;
 */


/**
 * @brief Creates pair generator defined by range of values for first and second.
 *
 * @tparam T Integral type to be stored in the pair.
 *
 * @param first_left Left endpoint of value range for first.
 * @param first_right Right endpoint of value range for first.
 * @param second_left Left endpoint of value range for second.
 * @param second_right Right endpoint of value range for second.
 *
 * Defines a generator of pairs with first in @tt{[@pname{first_left}, @pname{first_right}]}
 * and second in @tt{[@pname{second_left}, @pname{second_right}]}.
 *
 * #### Examples
 *
 * ```cpp
 * // Pairs of ints with first in [5, 10] and second in [10, 20].
 * auto pair_gen = tgen::pair<int>(5, 10, 10, 20);
 * ```
 *
 * @fn pair::pair(T first_left, T first_right, T second_left, T second_right);
 */


/**
 * @brief Creates pair generator defined by range of values for both first and second.
 *
 * @tparam T Integral type to be stored in the pair.
 *
 * @param both_left Left endpoint of value range for first and second.
 * @param both_right Right endpoint of value range for first and second;
 *
 * Defines a generator of pairs with first in @tt{[@pname{both_left}, @pname{both_right}]}
 * and second in @tt{[@pname{both_left}, @pname{both_right}]}.
 *
 * Equivalent to @tt{tgen::pair::pair(@pname{both_left}, @pname{both_right}, @pname{both_left}, @pname{both_right})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Pairs of ints with values in [10, 20].
 * auto pair_gen = tgen::pair<int>(10, 20);
 * ```
 *
 * @fn pair::pair(T both_left, T both_right);
 */


/**
 * @brief Restricts generator s.t. first is equal to second.
 *
 * #### Examples
 *
 * ```cpp
 * // Pairs of values in [10, 20] with first = second.
 * auto pair_gen = tgen::pair<int>(10, 20).eq();
 * ```
 *
 * @fn pair::eq();
 */


/**
 * @brief Restricts generator s.t. first is not equal to second.
 *
 * #### Examples
 *
 * ```cpp
 * // Pairs of values in [10, 20] with first != second.
 * auto pair_gen = tgen::pair<int>(10, 20).neq();
 * ```
 *
 * @fn pair::neq();
 */


/**
 * @brief Restricts generator s.t. first is less than second.
 *
 * #### Examples
 *
 * ```cpp
 * // Pairs of values in [10, 20] with first < second.
 * auto pair_gen = tgen::pair<int>(10, 20).lt();
 * ```
 *
 * @fn pair::lt();
 */


/**
 * @brief Restricts generator s.t. first is greater than second.
 *
 * #### Examples
 *
 * ```cpp
 * // Pairs of values in [10, 20] with first > second.
 * auto pair_gen = tgen::pair<int>(10, 20).gt();
 * ```
 *
 * @fn pair::gt();
 */


/**
 * @brief Restricts generator s.t. first is less than or equal to second.
 *
 * #### Examples
 *
 * ```cpp
 * // Pairs of values in [10, 20] with first <= second.
 * auto pair_gen = tgen::pair<int>(10, 20).leq();
 * ```
 *
 * @fn pair::leq();
 */


/**
 * @brief Restricts generator s.t. first is greater than or equal to second.
 *
 * #### Examples
 *
 * ```cpp
 * // Pairs of values in [10, 20] with first >= second.
 * auto pair_gen = tgen::pair<int>(10, 20).geq();
 * ```
 *
 * @fn pair::geq();
 */


/**
 * @brief Generates a uniformly random value from the set of valid pairs.
 *
 * @return A uniformly random @tt{tgen::pair::value} from the set of valid pairs, given the added restrictions.
 *
 * @throws std::runtime_error if there is no valid pair satisfying all added restrictions.
 *
 * #### Complexity
 *
 * @tt{O(log(@pname{first_right} - @pname{first_left}) + log(@pname{second_right} - @pname{second_left}))}.
 *
 * #### Examples
 *
 * ```cpp
 * // Generates and prints a random pair of values in [10, 20] with first <= second.
 * auto val = tgen::pair<int>(10, 20).leq().gen();
 * std::cout << val << std::endl;
 * ```
 *
 * @fn pair::gen() const;
 */





/**
 * @ingroup pair
 * @brief Pair value.
 *
 * It can be deterministically operated upon and printed through @tt{@namespace{std}::cout}.
 *
 * @struct pair::value;
 */


/**
 * @brief Creates a pair value from a @texttt{@namespace{std}::@type{pair}}.
 *
 * @param pair The @texttt{@namespace{std}::@type{pair}} representing the pair.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates and prints a pair from a std::pair.
 * std::pair<int, int> p = {2, 3};
 * tgen::pair<int>::value val(p);
 * std::cout << val << std::endl; // Prints "2 3".
 * ```
 *
 * @fn pair::value::value(const std::pair<T, T>& pair);
 */


/**
 * @brief Creates a pair value from first and second values.
 *
 * @param first First element of the pair.
 * @param second Second element of the pair.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates and prints a pair {2, 3}.
 * tgen::pair<int>::value val(2, 3);
 * std::cout << val << std::endl; // Prints "2 3".
 * ```
 *
 * @fn pair::value::value(const T &first, const T &second);
 */


/**
 * @brief Returns the first element of a pair value.
 *
 * @return The first element of the pair.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints the first element of a pair.
 * tgen::pair<int>::value val = {2, 3};
 * std::cout << val.first() << std::endl; // Prints "2".
 * ```
 *
 * @fn pair::value::first();
 */


/**
 * @brief Returns the second element of a pair value.
 *
 * @return The second element of the pair.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints the second element of a pair.
 * tgen::pair<int>::value val = {2, 3};
 * std::cout << val.second() << std::endl; // Prints "3".
 * ```
 *
 * @fn pair::value::second();
 */


/**
 * @brief Sets separator for printing.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints a pair, separated by comma.
 * tgen::pair<int>::value val = {2, 3};
 * std::cout << val.separator(',') << std::endl; // Prints "2,3".
 * ```
 *
 * @fn pair::value::separator(char sep);
 */


/**
 * @brief Prints the pair to an output stream.
 *
 * The pair elements are printed with one space as a separator by default,
 * and with no end of line.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints a pair.
 * std::cout <<
 *     tgen::pair<int>::value({2, 3}) << std::endl; // Prints "2 3".
 * ```
 *
 * @fn pair::value::operator<<(std::ostream &out, const value &val);
 */


/**
 * @brief Converts the pair to a @texttt{@namespace{std}::@type{pair}}.
 *
 * @return A @texttt{@namespace{std}::@type{pair}} representing the pair.
 *
 * #### Examples
 *
 * ```cpp
 * // Converts the pair to std::pair.
 * std::pair<int, int> p = tgen::pair<int>::value({2, 3}).to_std();
 * // p = {2, 3}.
 * ```
 *
 * @fn pair::value::to_std() const;
 */

};
#include "../single_include/tgen.h"

namespace tgen::geometry {

/**
 * @defgroup geometry Geometry
 * @brief Geometry utilities.
 *
 * ### Examples
 *
 * Vector operations on integer coordinates.
 *
 * ```cpp
 * tgen::geometry::point<int> a(1, 2), b(3, 4);
 * std::cout << a + b << std::endl;
 * std::cout << (a * b) << " " << (a ^ b) << std::endl;
 * ```
 *
 * ```
 * 4 6
 * 11 -2
 * ```
 *
 * Floating-point coordinates use epsilon-based equality (@tt{1e-9}).
 *
 * ```cpp
 * tgen::geometry::point<double> p(1.5, 2.5);
 * std::cout << p << std::endl;
 * ```
 *
 * ```
 * 1.5 2.5
 * ```
 *
 * Generates points in general position (no three collinear) inside a box.
 *
 * ```cpp
 * auto pts = tgen::geometry::random_points_general_position(5000, 0, 50000);
 * std::cout << tgen::print(pts, '\n') << std::endl;
 * ```
 *
 * ```
 * 18815 25522
 * 19859 26244
 * ...
 * ```
 * @image html random_points_general_position.png "Example generated point set" width=600
 *
 * Generates convex polygon.
 *
 * ```cpp
 * auto pts = tgen::geometry::random_convex_polygon(150, 0, 1500);
 * std::cout << tgen::print(pts, '\n') << std::endl;
 * ```
 *
 * ```
 * 1433 1182
 * 1428 1190
 * ...
 * ```
 * @image html random_convex_polygon.png "Example generated polygon" width=600
 *
 * Generates a simple polygon.
 *
 * ```cpp
 * auto poly = tgen::geometry::random_simple_polygon(200, 0, 2000);
 * std::cout << tgen::print(poly, '\n') << std::endl;
 * ```
 *
 * ```
 * 842 368
 * 847 379
 * ...
 * ```
 * @image html simple_polygon.png "Example generated polygon" width=600
 *
 * Simple polygon through a grid of points.
 *
 * ```cpp
 * std::vector<tgen::geometry::point<long long>> pts;
 * for (int y = 0; y < 10; ++y)
 *     for (int x = 0; x < 10; ++x)
 *         pts.emplace_back(x, y);
 * auto poly = tgen::geometry::random_simple_polygon_through_points(pts);
 * std::cout << tgen::print(poly, '\n') << std::endl;
 * ```
 *
 * ```
 * 0 1
 * 0 2
 * ...
 * ```
 * @image html grid_polygon.png "Example grid polygon" width=600
 *
 * Generates a random orthogonal (axis-aligned) simple polygon.
 *
 * ```cpp
 * auto poly = tgen::geometry::random_orthogonal_polygon(200, 0, 2000);
 * std::cout << tgen::print(poly, '\n') << std::endl;
 * ```
 *
 * ```
 * 1164 1866
 * 1164 1862
 * ...
 * ```
 * @image html random_orthogonal_polygon.png "Example generated orthogonal polygon" width=600
 */





/**
 * @ingroup geometry
 * @brief Point on the plane.
 *
 * @tparam T Arithmetic coordinate type (@tt{@primitive{int}}, @tt{@primitive{double}}, ...).
 *
 * Dot and cross products return @tt{@type{product_t}}, widened to avoid overflow:
 * @tt{@type{__int128}} when @tt{T} is @tt{@primitive{long long}}, @tt{@primitive{long long}} for other
 * integral @tt{T}, and @tt{T} for floating-point @tt{T}.
 *
 * For floating-point @tt{T}, @tt{operator==} and lexicographic
 * @tt{operator<} compare coordinates with tolerance @tt{1e-9}.
 *
 * @struct point;
 */


/**
 * @brief Constructs a point.
 *
 * @param x x-coordinate.
 * @param y y-coordinate.
 *
 * @fn point::point(T x = 0, T y = 0);
 */


/**
 * @brief x coordinate.
 *
 * #### Examples
 *
 * ```cpp
 * tgen::geometry::point<int> p(3, 4);
 * std::cout << p.x() << std::endl; // Prints "3".
 * ```
 *
 * @fn point::x() const;
 */


/**
 * @brief y coordinate.
 *
 * #### Examples
 *
 * ```cpp
 * tgen::geometry::point<int> p(3, 4);
 * std::cout << p.y() << std::endl; // Prints "4".
 * ```
 *
 * @fn point::y() const;
 */


/**
 * @brief Lexicographic order.
 *
 * For floating-point coordinates, @tt{x_} values within @tt{1e-9} are treated
 * as equal before comparing @tt{y_}.
 *
 * @fn point::operator<(const point &p) const;
 */


/**
 * @brief Coordinate-wise equality.
 *
 * For floating-point coordinates, two values are equal when their difference
 * is at most @tt{1e-9} in absolute value.
 *
 * @fn point::operator==(const point &p) const;
 */


/**
 * @brief Vector addition.
 *
 * @return The sum of the vectors.
 *
 * #### Examples
 *
 * ```cpp
 * tgen::geometry::point<int> a(1, 2), b(3, 4);
 * std::cout << a + b << std::endl;
 * ```
 *
 * @fn point::operator+(const point &p) const;
 */


/**
 * @brief Vector subtraction.
 *
 * @return The subtraction of the vectors.
 *
 * #### Examples
 *
 * ```cpp
 * tgen::geometry::point<int> a(1, 2), b(3, 4);
 * std::cout << a - b << std::endl;
 * ```
 *
 * @fn point::operator-(const point &p) const;
 */


/**
 * @brief Scalar multiplication.
 *
 * @param c Scalar.
 *
 * @fn point::operator*(T c) const;
 */


/**
 * @brief Dot product.
 *
 * @return The dot product as @tt{@type{product_t}} (@tt{@type{__int128}} for
 * @tt{@type{point}<@primitive{long long}>}, @tt{@primitive{long long}} for other integral @tt{T}, @tt{T}
 * for floating-point).
 *
 * @fn point::operator*(const point &p) const;
 */


/**
 * @brief Cross product.
 *
 * @return The signed magnitude of the cross product as @tt{@type{product_t}}
 * (@tt{@type{__int128}} for @tt{@type{point}<@primitive{long long}>}, @tt{@primitive{long long}} for other integral
 * @tt{T}, @tt{T} for floating-point).
 *
 * @fn point::operator^(const point &p) const;
 */


/**
 * @brief Prints the coordinates separated by a space.
 *
 * #### Examples
 *
 * ```cpp
 * tgen::geometry::point<int> p(3, 4);
 * std::cout << p << std::endl; // Prints "3 4".
 * ```
 *
 * @fn point::operator<<(std::ostream &out, const point &p);
 */


/**
 * @ingroup geometry
 * @brief Generates random points in general position inside a coordinate box.
 *
 * @param n Number of points to generate.
 * @param min_coord Minimum allowed coordinate on each axis.
 * @param max_coord Maximum allowed coordinate on each axis.
 *
 * @return @tt{@pname{n}} distinct @tt{point<long long>} values with integer
 * coordinates in the inclusive square
 * @tt{[@pname{min_coord}, @pname{max_coord}]^2} such that no three points are
 * collinear.
 *
 * The construction samples @tt{@pname{n}} distinct values @tt{(x, x^-1)} from
 * @tt{F_p} then applies several
 * random invertible shears over @tt{F_p}, then translates the result into
 * @tt{[@pname{min_coord}, @pname{max_coord}]^2}. Affine maps preserve
 * (non-)collinearity, and the graph of inversion over @tt{F_p} meets any line
 * in at most two points.
 *
 * @throws std::runtime_error if the coordinate range is not large enough.
 *
 * @note This operation is not uniformly random.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n})}.
 *
 * #### Examples
 *
 * ```cpp
 * std::vector<tgen::geometry::point<long long>> pts = tgen::geometry::random_points_general_position(10, 0, 100);
 * std::cout << tgen::print(pts, '\n') << std::endl;
 * ```
 *
 * @fn random_points_general_position(int n, long long min_coord, long long max_coord);
 */


/**
 * @ingroup geometry
 * @brief Generates a random simple polygon through given points.
 *
 * @param points Distinct points.
 *
 * @pre @tt{@pname{points}.size() >= 3}, all points are distinct, and they are
 * not all collinear.
 *
 * @return The same points listed in counterclockwise boundary order of a
 * simple (non-self-intersecting) polygon.
 *
 * Uses a randomized divide-and-conquer Hamiltonian-path construction on the
 * leftmost and rightmost vertices.
 *
 * @note This operation is not uniformly random.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{points}| log|@pname{points}|)} expected (if points are "random"),
 * @tt{O(|@pname{points}|^2)} worst case.
 *
 * #### Examples
 *
 * ```cpp
 * auto pts = tgen::geometry::random_points_general_position(10, 0, 100);
 * auto poly = tgen::geometry::random_simple_polygon_through_points(pts);
 * std::cout << tgen::print(poly, '\n') << std::endl;
 * ```
 *
 * @fn random_simple_polygon_through_points(const std::vector<point<long long>> &points);
 */


/**
 * @ingroup geometry
 * @brief Generates a random simple polygon given coordinate range.
 *
 * @param n Number of vertices to generate.
 * @param min_coord Minimum allowed coordinate on each axis.
 * @param max_coord Maximum allowed coordinate on each axis.
 * @param strict If @tt{@primitive{true}}, the vertex set has no three
 * collinear points. If @tt{@primitive{false}}, there might be collinear
 * triplets and three consecutive collinear points in the polygon.
 *
 * @pre @tt{@pname{n} >= 3}.
 *
 * @return @tt{@pname{n}} distinct vertices listed in counterclockwise
 * boundary order of a simple (non-self-intersecting) polygon. Coordinates lie
 * in the inclusive square @tt{[@pname{min_coord}, @pname{max_coord}]^2}.
 *
 * When @pname{strict} is @tt{@primitive{true}}, the point set is built with
 * @ref random_points_general_position, othwerwise randomly generated. Points are polygonized by
 * @ref random_simple_polygon_through_points.
 *
 * @throws std::runtime_error if the coordinate range is not large enough.
 *
 * @note This operation is not uniformly random.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n} log @pname{n})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * std::vector<tgen::geometry::point<long long>> poly = tgen::geometry::random_simple_polygon(10, 0, 100);
 * std::cout << tgen::print(poly, '\n') << std::endl;
 *
 * // Strict: no three collinear vertices.
 * auto strict_poly = tgen::geometry::random_simple_polygon(10, 0, 100, true);
 * ```
 *
 * @fn random_simple_polygon(int n, long long min_coord, long long max_coord, bool strict = false);
 */


/**
 * @ingroup geometry
 * @brief Generates a random convex polygon with given coordinate range.
 *
 * @param n Number of vertices.
 * @param min_coord Minimum allowed coordinate on each axis.
 * @param max_coord Maximum allowed coordinate on each axis.
 * @param strict If @tt{@primitive{true}}, the polygon is strictly convex.
 * If @tt{@primitive{false}}, collinear vertices may occur.
 *
 * @pre @tt{@pname{n} >= 3}.
 *
 * @return @tt{@pname{n}} distinct vertices of a convex polygon with integer
 * coordinates in the inclusive square
 * @tt{[@pname{min_coord}, @pname{max_coord}]^2}, listed in counterclockwise
 * order. When @pname{strict} is @tt{@primitive{true}}, the polygon is
 * strictly convex.
 *
 * Uses Valtr's classical construction: choose @tt{m} distinct sorted @tt{x} and
 * @tt{y} coordinates in @tt{[@pname{min_coord}, @pname{max_coord}]} via @tt{tgen::distinct_range} (with
 * @tt{m = @pname{n}} when @pname{strict} is @tt{@primitive{false}}, and
 * @tt{m > @pname{n}} when @pname{strict} is @tt{@primitive{true}}), build
 * monotone signed edge components, shuffle the @tt{y}-components, pair with the
 * @tt{x}-components, and sort by polar angle, then
 * prefix-sum to obtain vertex coordinates. When @pname{strict} is
 * @tt{@primitive{true}}, collinear boundary vertices are removed and the walk
 * is subsampled to @tt{@pname{n}} vertices. The polygon is then translated by
 * a random amount so it lies inside the requested box.
 *
 * @throws std::runtime_error if the coordinate range is not large enough.
 *
 * @warning When @pname{strict} is @tt{@primitive{true}}, the implementation
 * retries a bounded number of times. Use a
 * larger coordinate range if generation fails. <br>
 * When @pname{strict} is @tt{@primitive{false}}, generation succeeds as long as
 * @tt{@pname{max_coord} - @pname{min_coord} + 1 >= @pname{n}}.
 *
 * @note This operation is not uniformly random.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n} log @pname{n})}.
 * #### Examples
 *
 * ```cpp
 * auto poly = tgen::geometry::random_convex_polygon(10, 0, 100);
 * std::cout << tgen::print(poly, '\n') << std::endl;
 * ```
 *
 * @fn random_convex_polygon(int n, long long min_coord, long long max_coord, bool strict);
 */


/**
 * @ingroup geometry
 * @brief Generates a random orthogonal simple polygon.
 *
 * @param n Target number of boundary vertices.
 * @param min_coord Minimum allowed coordinate on each axis.
 * @param max_coord Maximum allowed coordinate on each axis.
 * @param strict If @tt{@primitive{true}}, every vertex turns 90 degrees
 * (no three consecutive collinear vertices). If @tt{@primitive{false}},
 * collinear vertices may appear on straight horizontal or vertical edges.
 *
 * @pre @tt{@pname{n} >= 4}.
 *
 * @return Vertices of a simple orthogonal polygon with axis-aligned edges,
 * listed in counterclockwise order. When @pname{strict} is
 * @tt{@primitive{false}}, the vertex count is exactly @pname{n}. When
 * @pname{strict} is @tt{@primitive{true}}, the count is at most @pname{n}
 * (generally close to @pname{n}).
 *
 * #### Generation
 *
 * The polygon starts as a small axis-aligned square. The
 * implementation then applies local boundary edits inspired by inflate/cut
 * operations:
 *
 * - **Inflate (outward tab):** (~75% of steps) a rectangular protrusion is
 *   spliced onto a boundary subsegment, growing the shape outward.
 * - **Cut (inward notch):** (~25% of steps) a rectangular bite is taken out
 *   of the boundary, creating bays and concavities.
 *
 * Each step picks a boundary edge (favoring longer segments and edges that
 * were not edited recently), chooses a subsegment and depth, then splices the
 * rectangle if validation passes. When @pname{strict} is
 * @tt{@primitive{true}}, collinear vertices are removed.
 *
 * @throws std::runtime_error if the coordinate range is too small or
 * generation fails.
 *
 * @note This operation is not uniformly random.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n}^2)} for @tt{@pname{n} <= 1000}; <br>
 * @tt{O(@pname{n})} otherwise.
 *
 * #### Examples
 *
 * ```cpp
 * auto poly = tgen::geometry::random_orthogonal_polygon(40, 0, 400);
 * std::cout << tgen::print(poly, '\n') << std::endl;
 *
 * // Strict: only 90-degree corners.
 * auto strict_poly = tgen::geometry::random_orthogonal_polygon(40, 0, 400, true);
 * ```
 *
 * @fn random_orthogonal_polygon(int n, long long min_coord, long long max_coord, bool strict = false);
 */

}; // namespace tgen::geometry

#include "../single_include/tgen.h"

namespace tgen::math {

/**
 * @defgroup math Math Operations
 * @brief Operations regarding number theory and related topics.
 *
 * ### Examples
 *
 * ```cpp
 * // Generates a random prime from 1 to 1e18.
 * auto p = tgen::math::gen_prime(1, 1e18);
 *
 * // Prints primes between 100 and 200.
 * for (int p = tgen::math::next_prime(100); p < 200; p = tgen::math::next_prime(p)) {
 *     std::cout << p << std::endl;
 * }
 * 
 * // Computes largest prime gap up to 1e12.
 * auto [l, r] = tgen::math::prime_gap_upto(1e12);
 * 
 * // Prints random two-digit number that is even and congruent to 1 mod 3.
 * std::cout << tgen::math::gen_congruent(10, 99, {0, 1}, {2, 3}) << std::endl;
 * 
 * // Random partition of 10 into 4 parts in [2, 3].
 * auto part = tgen::math::gen_partition_fixed_size(10, 4, 2, 3);
 * ```
 */


/**
 * @ingroup math
 * @brief Checks if a number is prime.
 *
 * @param n Number to check.
 *
 * @return If the number is prime.
 *
 * #### Complexity
 *
 * @tt{O(log^2 @pname{n})}.
 *
 * #### Examples
 *
 * ```cpp
 * bool is_prime = tgen::math::is_prime(17);
 * // true
 * ```
 *
 * @fn is_prime(uint64_t n);
 */


/**
 * @ingroup math
 * @brief Factors a number into primes.
 *
 * @param n Number to factor.
 *
 * @pre @tt{@pname{n} > 0}.
 *
 * @return List of prime factors of @pname{n}, in non-decreasing order.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n}^(1/4) log @pname{n})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * auto fact = tgen::math::factor(24);
 * // {2, 2, 2, 3}
 * ```
 *
 * @fn factor(uint64_t n);
 */


/**
 * @ingroup math
 * @brief Factors a number into primes and its powers.
 *
 * @param n Number to factor.
 *
 * @pre @tt{@pname{n} > 0}.
 *
 * @return List of prime factors of @pname{n}, in increasing order, with its respective powers.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n}^(1/4) log @pname{n})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * auto fact = tgen::math::factor_by_prime(24);
 * // {{2, 3}, {3, 1}}
 * ```
 *
 * @fn factor_by_prime(uint64_t n);
 */


/**
 * @ingroup math
 * @brief Computes modular inverse.
 *
 * @param a Number to compute the inverse of, mod @pname{mod}.
 * @param mod Mod.
 *
 * @pre
 * @tt{@pname{mod} > @pname{a} >= 0}. <br>
 * @tt{gcd(@pname{a}, @pname{mod}) = 1}.
 *
 * @return Inverse of @pname{a} mod @pname{mod}.
 *
 * #### Complexity
 *
 * @tt{O(log @pname{mod})}.
 *
 * #### Examples
 *
 * ```cpp
 * auto inv = tgen::math::modular_inverse(3, 10);
 * std::cout << 3 * inv % 10 << std::endl;
 * // "1"
 * ```
 *
 * @fn modular_inverse(uint64_t a, uint64_t mod);
 */


/**
 * @ingroup math
 * @brief Euler's totient function.
 *
 * @param n Number to compute the totient of.
 *
 * @pre
 * @tt{@pname{n} > 0}.
 *
 * @return Totient of @pname{n}.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n}^(1/4) log @pname{n})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * std::cout << tgen::math::totient(10) << std::endl;
 * // "4"
 * ```
 *
 * @fn totient(uint64_t n);
 */


/**
 * @ingroup math
 * @brief Fetches prime gaps.
 *
 * Fetches maximal prime gaps for numbers that fit in @primitive{uint64_t} (less than @tt{2^64}).
 *
 * @return Columns @tt{p_n} and @tt{g_n} from
 * <a href="https://en.wikipedia.org/wiki/Prime_gap#Numerical_results" target="_blank">wikipedia</a>.
 *
 * #### Examples
 *
 * ```cpp
 * const auto &[p, g] = tgen::math::prime_gaps();
 * ```
 *
 * @fn prime_gaps();
 */


/**
 * @ingroup math
 * @brief Largest prime gap up to given number.
 *
 * @param r Bound.
 *
 * @return Largest prime gap no larger than @pname{r}.
 *
 * #### Examples
 *
 * ```cpp
 * // Computes largest prime gap up to 1e12.
 * auto [l, r] = tgen::math::prime_gap_upto(1e12);
 * ```
 *
 * @fn prime_gap_upto(uint64_t r);
 */


/**
 * @ingroup math
 * @brief Fetches highly composite numbers.
 *
 * Fetches highly composite numbers that fit in @primitive{uint64_t} (less than @tt{2^64}).
 *
 * @return Highly composite numbers from 
 * <a href="https://oeis.org/A002182/b002182.txt" target="_blank">wikipedia</a>.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints largest highly composite number that fits in 64 bits.
 * std::cout << tgen::math::highly_composites().back() << std::endl;
 * ```
 *
 * @fn highly_composites();
 */


/**
 * @ingroup math
 * @brief Largest highly composite number up to given number.
 *
 * @param r Bound.
 *
 * @return Largest highly composite number no larger than @pname{r}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints largest highly composite number up to 1e12.
 * std::cout << tgen::math::highly_composite_upto(1e12) << std::endl;
 * ```
 *
 * @fn highly_composite_upto(uint64_t r);
 */


/**
 * @ingroup math
 * @brief Generates a random prime in given range.
 *
 * @param l Left endpoint of range.
 * @param r Right endpoint of range.
 *
 * @pre
 * @tt{@pname{n} > 0}.
 *
 * @return A uniformly random prime in @tt{[@pname{l}, @pname{r}]}.
 *
 * #### Complexity
 *
 * @tt{O(log @pname{r})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * // Generates a random prime from 1 to 1e18.
 * auto p = tgen::math::gen_prime(1, 1e18);
 * ```
 *
 * @fn gen_prime(uint64_t l, uint64_t r);
 */


/**
 * @ingroup math
 * @brief Computes smallest prime larger than given value.
 *
 * @param l Bound.
 *
 * @pre
 * @tt{@pname{l} < 2^64 - 59}.
 *
 * @return Smallest prime larger than @pname{l}.
 *
 * #### Complexity
 *
 * @tt{O(log^3 @pname{l})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints primes between 100 and 200.
 * for (int p = tgen::math::next_prime(100); p < 200; p = tgen::math::next_prime(p)) {
 *     std::cout << p << std::endl;
 * }
 * ```
 *
 * @fn next_prime(uint64_t l);
 */


/**
 * @ingroup math
 * @brief Computes largest prime smaller than given value.
 *
 * @param r Bound.
 *
 * @return Largest prime smaller than @pname{r}.
 *
 * #### Complexity
 *
 * @tt{O(log^3 @pname{r})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints primes between 100 and 200 in reverse.
 * for (int p = tgen::math::prev_prime(200); p > 100; p = tgen::math::prev_prime(p)) {
 *     std::cout << p << std::endl;
 * }
 * ```
 *
 * @fn prev_prime(uint64_t r);
 */


/**
 * @ingroup math
 * @brief Computes the number of divisors of a given number.
 *
 * @param n Number to compute the ammount of divisors of.
 *
 * @pre
 * @tt{@pname{n} > 0}.
 *
 * @return Number of divisors of @pname{n}.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n}^(1/4) log @pname{n})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * std::cout << tgen::math::num_divisors(12) << std::endl;
 * // "6"
 * ```
 *
 * @fn num_divisors(uint64_t n);
 */


/**
 * @ingroup math
 * @brief Generates random number in range with a given prime number of divisors.
 *
 * @param l Left endpoint of range.
 * @param r Right endpoint of range.
 * @param divisor_count Number of divisors.
 *
 * @pre
 * @pname{divisor_count} is prime.
 *
 * @return Uniformly random number with given prime number of divisors.
 *
 * #### Complexity
 *
 * @tt{O(log(@pname{r}) log(@pname{divisor_count}))}.
 *
 * #### Examples
 *
 * ```cpp
 * // Generates a random number from 100 to 200 with 3 divisors (p^2).
 * auto n = tgen::math::num_divisors(100, 200, 3);
 * ```
 *
 * @fn gen_divisor_count(uint64_t l, uint64_t r, int divisor_count);
 */


/**
 * @ingroup math
 * @brief Generates random number in range given modular congruences.
 *
 * @param l Left endpoint of range.
 * @param r Right endpoint of range.
 * @param rems Remainders.
 * @param mods Mods.
 *
 * @pre
 * @tt{|@pname{rems}| = |@pname{mods}|}. <br>
 * @tt{@pname{rems}[i] < @pname{mods}[i]}.
 *
 * @return Uniformly random number in @tt{[@pname{l}, @pname{r}]} that is congruent to
 * @tt{@pname{rems}[i]} mod @tt{@pname{mods}[i]}.
 *
 * @throws std::runtime_error if there is no such number.
 *
 * #### Complexity
 *
 * @tt{O(|@pname{mods}| + log @pname{r})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints random two-digit number that is even and congruent to 1 mod 3.
 * std::cout << tgen::math::gen_congruent(10, 99, {0, 1}, {2, 3}) << std::endl;
 * ```
 *
 * @fn gen_congruent(uint64_t l, uint64_t r, std::vector<uint64_t> rems, std::vector<uint64_t> mods);
 */


/**
 * @ingroup math
 * @brief Generates random number in range given a modular congruence.
 *
 * @param l Left endpoint of range.
 * @param r Right endpoint of range.
 * @param rem Remainder.
 * @param mod Mod.
 *
 * @pre
 * @tt{@pname{rem} < @pname{mod}}.
 *
 * Equivalent to @tt{tgen::math::gen_congruent(@pname{l}, @pname{r}, {@pname{rem}}, {@pname{mod}})}.
 *
 * @return Uniformly random number in @tt{[@pname{l}, @pname{r}]} that is congruent
 * to @pname{rem} mod @pname{mod}.
 *
 * @throws std::runtime_error if there is no such number.
 *
 * #### Complexity
 *
 * @tt{O(1)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints random two-digit number that is congruent to 1 mod 3.
 * std::cout << tgen::math::gen_congruent(10, 99, 1, 3) << std::endl;
 * ```
 *
 * @fn gen_congruent(uint64_t l, uint64_t r, uint64_t rem, uint64_t mod);
 */


/**
 * @ingroup math
 * @brief Generates random even number in a given range.
 *
 * @param l Left endpoint of range.
 * @param r Right endpoint of range.
 *
 * Equivalent to @tt{tgen::math::gen_congruent(@pname{l}, @pname{r}, {0}, {2})}.
 *
 * @return Uniformly random even number in @tt{[@pname{l}, @pname{r}]}.
 *
 * @throws std::runtime_error if there is no such number.
 *
 * #### Complexity
 *
 * @tt{O(log @pname{r})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints random two-digit even number.
 * std::cout << tgen::math::gen_even(10, 99) << std::endl;
 * ```
 *
 * @fn gen_even(uint64_t l, uint64_t r);
 */


/**
 * @ingroup math
 * @brief Generates random odd number in a given range.
 *
 * @param l Left endpoint of range.
 * @param r Right endpoint of range.
 *
 * Equivalent to @tt{tgen::math::gen_congruent(@pname{l}, @pname{r}, {1}, {2})}.
 *
 * @return Uniformly random odd number in @tt{[@pname{l}, @pname{r}]}.
 *
 * @throws std::runtime_error if there is no such number.
 *
 * #### Complexity
 *
 * @tt{O(log @pname{r})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints random two-digit odd number.
 * std::cout << tgen::math::gen_odd(10, 99) << std::endl;
 * ```
 *
 * @fn gen_odd(uint64_t l, uint64_t r);
 */


/**
 * @ingroup math
 * @brief FFT/NTT mod.
 *
 * #### Examples
 *
 * ```cpp
 * int fft_mod = tgen::math::FFT_MOD;
 * ```
 *
 * @var FFT_MOD;
 */


/**
 * @ingroup math
 * @brief Fetches Fibonacci numbers.
 *
 * Fetches Fibonacci numbers that fit in @primitive{uint64_t} (less than @tt{2^64}).
 *
 * #### Examples
 *
 * ```cpp
 * // Prints 5th fibonacci number.
 * std::cout << tgen::math::fibonacci()[5] << std::endl;
 * ```
 *
 * @fn fibonacci();
 */


/**
 * @ingroup math
 * @brief Generates a random partition of a number.
 *
 * @param n Number to partition.
 * @param part_l Minimum part value.
 * @param part_r Maximum part value.
 *
 * @pre
 * @tt{@pname{n} > 0}. <br>
 * @tt{@pname{part_l} > 0}.
 *
 * Partition is ordered (so technically a composition). That is, @tt{(1, 1, 2) != (1, 2, 1)}.
 * If @tt{@pname{part_r} = -1}, @pname{part_r} is considered to be @pname{n} (unbounded).
 *
 * @return A uniformly random ordered partition of @pname{n} with values in @tt{[@pname{part_l}, @pname{part_r}]}.
 *
 * @throws std::runtime_error if there is no such partition.
 *
 * @note Distribution might be slighly biased because of floating point arithmetic.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Random partition of 10 into parts in [2, 3].
 * auto part = tgen::math::partition(10, 2, 3);
 * ```
 *
 * @fn gen_partition(int n, int part_l = 1, int part_r = -1);
 */


/**
 * @ingroup math
 * @brief Generates a random partition with fixed size of a number.
 *
 * @param n Number to partition.
 * @param k Number of parts.
 * @param part_l Minimum part value.
 * @param part_r Maximum part value.
 *
 * @pre
 * @tt{@pname{n} >= @pname{k} > 0}. <br>
 * @tt{@pname{part_l} >= 0}.
 *
 * Partition is ordered (so technically a composition). That is, @tt{(1, 1, 2) != (1, 2, 1)}.
 * If @tt{@pname{part_r} = -1}, @pname{part_r} is considered to be @pname{n} (unbounded).
 *
 * @return A uniformly random ordered partition of @pname{n} with length @pname{k} and values
 * in @tt{[@pname{part_l}, @pname{part_r}]}.
 *
 * @throws std::runtime_error if there is no such partition.
 *
 * @note Distribution might be slighly biased because of floating point arithmetic.
 *
 * #### Complexity
 *
 * @tt{O(@pname{n})} time/memory if @tt{@pname{part_r} = -1}; <br>
 * @tt{O(@pname{n} * @pname{k})} time/memory otherwise.
 *
 * #### Examples
 *
 * ```cpp
 * // Random partition of 10 into 4 parts in [2, 3].
 * auto part = tgen::math::partition_fixed_size(10, 4, 2, 3);
 * ```
 *
 * @fn gen_partition_fixed_size(int n, int k, int part_l = 0, int part_r = -1);
 */

};

#include "../single_include/tgen.h"

namespace tgen::math {

/**
 * @defgroup math Math Operations
 * @brief Operations regarding number theory and related topics.
 *
 * ### Examples
 *
 * Generates a random prime from 1 to @tt{1e18}.
 *
 * ```cpp
 * std::cout << tgen::math::gen_prime(1, 1e18) << std::endl;
 * ```
 *
 * ```
 * 104297037245455381
 * ```
 *
 * Prints primes from 100 to 200.
 *
 * ```cpp
 * for (int p = tgen::math::prime_from(100); p <= 200; p = tgen::math::prime_from(p + 1)) {
 *     std::cout << p << std::endl;
 * }
 * ```
 *
 * ```
 * 101
 * 103
 * ...
 * 199
 * ```
 *
 * Largest prime gap up to @tt{1e12}.
 *
 * ```cpp
 * auto [l, r] = tgen::math::prime_gap_upto(1e12);
 * std::cout << l << " " << r << " " << r - l << std::endl;
 * ```
 *
 * ```
 * 738832927928 738832928466 538
 * ```
 *
 * Prints random two-digit number that is even and congruent to 1 mod 3.
 *
 * ```cpp
 * std::cout << tgen::math::gen_congruent(10, 99, {0, 1}, {2, 3}) << std::endl;
 * ```
 *
 * ```
 * 34
 * ```
 *
 * Random partition of 10 into 4 parts in @tt{[2, 3]}.
 *
 * ```cpp
 * std::cout << tgen::print(tgen::math::gen_partition_fixed_size(10, 4, 2, 3)) << std::endl;
 * ```
 *
 * ```
 * 3 3 2 2
 * ```
 */


/**
 * @ingroup math
 * @brief Checks if a number is prime.
 *
 * @param n Number to check.
 *
 * @return If the number is prime.
 *
 * #### Time complexity
 *
 * @tt{O(log^2 @pname{n})}.
 *
 * #### Examples
 *
 * ```cpp
 * bool is_prime = tgen::math::is_prime(17);
 * // true
 * ```
 *
 * @fn is_prime(uint64_t n);
 */


/**
 * @ingroup math
 * @brief Factors a number into primes.
 *
 * @param n Number to factor.
 *
 * @pre @tt{@pname{n} > 0}.
 *
 * @return List of prime factors of @pname{n}, in non-decreasing order.
 *
 * #### Time complexity
 *
 * @tt{O(@pname{n}^(1/4) log @pname{n})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * auto fact = tgen::math::factor(24);
 * // {2, 2, 2, 3}
 * ```
 *
 * @fn factor(uint64_t n);
 */


/**
 * @ingroup math
 * @brief Factors a number into primes and its powers.
 *
 * @param n Number to factor.
 *
 * @pre @tt{@pname{n} > 0}.
 *
 * @return List of prime factors of @pname{n}, in increasing order, with its respective powers.
 *
 * #### Time complexity
 *
 * @tt{O(@pname{n}^(1/4) log @pname{n})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * auto fact = tgen::math::factor_by_prime(24);
 * // {{2, 3}, {3, 1}}
 * ```
 *
 * @fn factor_by_prime(uint64_t n);
 */


/**
 * @ingroup math
 * @brief Computes modular inverse.
 *
 * @param a Number to compute the inverse of, mod @pname{mod}.
 * @param mod Mod.
 *
 * @pre
 * @tt{@pname{mod} > @pname{a} >= 0}. <br>
 * @tt{gcd(@pname{a}, @pname{mod}) = 1}.
 *
 * @return Inverse of @pname{a} mod @pname{mod}.
 *
 * #### Time complexity
 *
 * @tt{O(log @pname{mod})}.
 *
 * #### Examples
 *
 * ```cpp
 * auto inv = tgen::math::modular_inverse(3, 10);
 * std::cout << 3 * inv % 10 << std::endl; // Prints "1".
 * ```
 *
 * @fn modular_inverse(uint64_t a, uint64_t mod);
 */


/**
 * @ingroup math
 * @brief Euler's totient function.
 *
 * @param n Number to compute the totient of.
 *
 * @pre
 * @tt{@pname{n} > 0}.
 *
 * @return Totient of @pname{n}.
 *
 * #### Time complexity
 *
 * @tt{O(@pname{n}^(1/4) log @pname{n})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * std::cout << tgen::math::totient(10) << std::endl; // Prints "4".
 * ```
 *
 * @fn totient(uint64_t n);
 */


/**
 * @ingroup math
 * @brief Fetches prime gaps.
 *
 * Fetches maximal prime gaps for numbers that fit in @primitive{uint64_t} (less than @tt{2^64}).
 *
 * @return Columns @tt{p_n} and @tt{g_n} from
 * <a href="https://en.wikipedia.org/wiki/Prime_gap#Numerical_results" target="_blank">wikipedia</a>.
 *
 * #### Examples
 *
 * ```cpp
 * const auto &[p, g] = tgen::math::prime_gaps();
 * ```
 *
 * @fn prime_gaps();
 */


/**
 * @ingroup math
 * @brief Largest prime gap up to given number.
 *
 * @param right Bound.
 *
 * @return Largest prime gap no larger than @pname{right}.
 *
 * #### Examples
 *
 * ```cpp
 * // Computes largest prime gap up to 1e12.
 * auto [l, r] = tgen::math::prime_gap_upto(1e12);
 * ```
 *
 * @fn prime_gap_upto(uint64_t right);
 */


/**
 * @ingroup math
 * @brief Fetches highly composite numbers.
 *
 * Fetches highly composite numbers that fit in @primitive{uint64_t} (less than @tt{2^64}).
 *
 * @return Highly composite numbers from
 * <a href="https://oeis.org/A002182/b002182.txt" target="_blank">OEIS A002182</a>.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints largest highly composite number that fits in 64 bits.
 * std::cout << tgen::math::highly_composites().back() << std::endl; // Prints "18401055938125660800".
 * ```
 *
 * @fn highly_composites();
 */


/**
 * @ingroup math
 * @brief Largest highly composite number up to given number.
 *
 * @param right Bound.
 *
 * @return Largest highly composite number no larger than @pname{right}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints largest highly composite number up to 1e12.
 * std::cout << tgen::math::highly_composite_upto(1e12) << std::endl; // Prints "963761198400".
 * ```
 *
 * @fn highly_composite_upto(uint64_t right);
 */


/**
 * @ingroup math
 * @brief Generates a random prime in given range.
 *
 * @param left Left endpoint of range.
 * @param right Right endpoint of range.
 *
 * @return A uniformly random prime in @tt{[@pname{left}, @pname{right}]}.
 *
 * @throws std::runtime_error if there is no prime in the given range.
 *
 * #### Time complexity
 *
 * @tt{O(log^3 @pname{right})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * // Generates a random prime from 1 to 1e18.
 * auto p = tgen::math::gen_prime(1, 1e18);
 * ```
 *
 * @fn gen_prime(uint64_t left, uint64_t right);
 */


/**
 * @ingroup math
 * @brief Computes smallest prime from given value.
 *
 * @param left Bound.
 *
 * @pre
 * @tt{@pname{left} <= 2^64 - 59}.
 *
 * @return Smallest prime larger than or equal to @pname{left}.
 *
 * #### Time complexity
 *
 * @tt{O(log^3 @pname{left})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints primes from 100 to 200.
 * for (int p = tgen::math::prime_from(100); p <= 200; p = tgen::math::prime_from(p + 1)) {
 *     std::cout << p << std::endl;
 * }
 * ```
 *
 * @fn prime_from(uint64_t left);
 */


/**
 * @ingroup math
 * @brief Computes largest prime up to given value.
 *
 * @param right Bound.
 *
 * @return Largest prime smaller than or equal to @pname{right}.
 *
 * #### Time complexity
 *
 * @tt{O(log^3 @pname{right})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints primes from 100 to 200 in reverse.
 * for (int p = tgen::math::prime_upto(200); p >= 100; p = tgen::math::prime_upto(p - 1)) {
 *     std::cout << p << std::endl;
 * }
 * ```
 *
 * @fn prime_upto(uint64_t right);
 */


/**
 * @ingroup math
 * @brief Computes the number of divisors of a given number.
 *
 * @param n Number to compute the amount of divisors of.
 *
 * @pre
 * @tt{@pname{n} > 0}.
 *
 * @return Number of divisors of @pname{n}.
 *
 * #### Time complexity
 *
 * @tt{O(@pname{n}^(1/4) log @pname{n})} expected.
 *
 * #### Examples
 *
 * ```cpp
 * std::cout << tgen::math::num_divisors(12) << std::endl; // Prints "6".
 * ```
 *
 * @fn num_divisors(uint64_t n);
 */


/**
 * @ingroup math
 * @brief Generates random number in range with a given prime number of divisors.
 *
 * @param left Left endpoint of range.
 * @param right Right endpoint of range.
 * @param divisor_count Number of divisors.
 *
 * @pre
 * @pname{divisor_count} must be prime.
 *
 * @return Uniformly random number with given prime number of divisors.
 *
 * #### Time complexity
 *
 * @tt{O(log(@pname{right}) log(@pname{divisor_count}))}.
 *
 * #### Examples
 *
 * ```cpp
 * // Generates a random number from 100 to 200 with 3 divisors (p^2).
 * auto n = tgen::math::gen_divisor_count(100, 200, 3);
 * ```
 *
 * @fn gen_divisor_count(uint64_t left, uint64_t right, int divisor_count);
 */


/**
 * @ingroup math
 * @brief Generates random number in range given modular congruences.
 *
 * @param left Left endpoint of range.
 * @param right Right endpoint of range.
 * @param rems Remainders.
 * @param mods Mods.
 *
 * @pre
 * @tt{|@pname{rems}| = |@pname{mods}|}. <br>
 * @tt{@pname{rems}[i] < @pname{mods}[i]}.
 *
 * @return Uniformly random number in @tt{[@pname{left}, @pname{right}]} that is congruent to
 * @tt{@pname{rems}[i]} mod @tt{@pname{mods}[i]}.
 *
 * @throws std::runtime_error if there is no such number.
 *
 * #### Time complexity
 *
 * @tt{O(|@pname{mods}| + log @pname{right})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints random two-digit number that is even and congruent to 1 mod 3.
 * std::cout << tgen::math::gen_congruent(10, 99, {0, 1}, {2, 3}) << std::endl;
 * ```
 *
 * @fn gen_congruent(uint64_t left, uint64_t right, std::vector<uint64_t> rems, std::vector<uint64_t> mods);
 */


/**
 * @ingroup math
 * @brief Generates random number in range given a modular congruence.
 *
 * @param left Left endpoint of range.
 * @param right Right endpoint of range.
 * @param rem Remainder.
 * @param mod Mod.
 *
 * @pre
 * @tt{@pname{rem} < @pname{mod}}.
 *
 * Equivalent to @tt{tgen::math::gen_congruent(@pname{left}, @pname{right}, {@pname{rem}}, {@pname{mod}})}.
 *
 * @return Uniformly random number in @tt{[@pname{left}, @pname{right}]} that is congruent
 * to @pname{rem} mod @pname{mod}.
 *
 * @throws std::runtime_error if there is no such number.
 *
 * #### Time complexity
 *
 * @tt{O(log @pname{right})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints random two-digit number that is congruent to 1 mod 3.
 * std::cout << tgen::math::gen_congruent(10, 99, 1, 3) << std::endl;
 * ```
 *
 * @fn gen_congruent(uint64_t left, uint64_t right, uint64_t rem, uint64_t mod);
 */


/**
 * @ingroup math
 * @brief Computes smallest congruent from given value.
 *
 * @param left Bound.
 * @param rems Remainders.
 * @param mods Mods.
 *
 * @pre
 * @tt{|@pname{rems}| = |@pname{mods}|}. <br>
 * @tt{@pname{rems}[i] < @pname{mods}[i]}.
 *
 * @return Smallest congruent larger than or equal to @pname{left}.
 *
 * @throws std::runtime_error if there is no such number or if it does not fit in @primitive{uint64_t}.
 *
 * #### Time complexity
 *
 * @tt{O(|@pname{mods}| + log(lcm))}, if @tt{lcm} is the least common multiple of the mods.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints congruent from 10.
 * std::cout << tgen::math::congruent_from(10, {0, 1}, {2, 3}) << std::endl;
 * ```
 *
 * @fn congruent_from(uint64_t left, std::vector<uint64_t> rems, std::vector<uint64_t> mods);
 */


/**
 * @ingroup math
 * @brief Computes smallest congruent from given value.
 *
 * @param left Bound.
 * @param rem Remainder.
 * @param mod Mod.
 *
 * @pre
 * @tt{@pname{rem} < @pname{mod}}.
 *
 * Equivalent to @tt{tgen::math::congruent_from(@pname{left}, {@pname{rem}}, {@pname{mod}})}.
 *
 * @return Smallest congruent larger than or equal to @pname{left}.
 *
 * @throws std::runtime_error if there is no such number or if it does not fit in @primitive{uint64_t}.
 *
 * #### Time complexity
 *
 * @tt{O(log @pname{mod})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints even number from 10.
 * std::cout << tgen::math::congruent_from(10, 0, 2) << std::endl;
 * ```
 *
 * @fn congruent_from(uint64_t left, uint64_t rem, uint64_t mod);
 */


/**
 * @ingroup math
 * @brief Computes largest congruent up to given value.
 *
 * @param right Bound.
 * @param rems Remainders.
 * @param mods Mods.
 *
 * @pre
 * @tt{|@pname{rems}| = |@pname{mods}|}. <br>
 * @tt{@pname{rems}[i] < @pname{mods}[i]}.
 *
 * @return Largest congruent smaller than or equal to @pname{right}.
 *
 * @throws std::runtime_error if there is no such number.
 *
 * #### Time complexity
 *
 * @tt{O(|@pname{mods}| + log @pname{right})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints congruent up to 1e3.
 * std::cout << tgen::math::congruent_upto(1e3, {0, 1}, {2, 3}) << std::endl;
 * ```
 *
 * @fn congruent_upto(uint64_t right, std::vector<uint64_t> rems, std::vector<uint64_t> mods);
 */


/**
 * @ingroup math
 * @brief Computes largest congruent up to given value.
 *
 * @param right Bound.
 * @param rem Remainder.
 * @param mod Mod.
 *
 * @pre
 * @tt{@pname{rem} < @pname{mod}}.
 *
 * Equivalent to @tt{tgen::math::congruent_upto(@pname{right}, {@pname{rem}}, {@pname{mod}})}.
 *
 * @return Largest congruent smaller than or equal to @pname{right}.
 *
 * @throws std::runtime_error if there is no such number.
 *
 * #### Time complexity
 *
 * @tt{O(log @pname{right})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints odd number up to 1e3.
 * std::cout << tgen::math::congruent_upto(1e3, 1, 2) << std::endl;
 * ```
 *
 * @fn congruent_upto(uint64_t right, uint64_t rem, uint64_t mod);
 */


/**
 * @ingroup math
 * @brief FFT/NTT mod.
 *
 * #### Examples
 *
 * ```cpp
 * int fft_mod = tgen::math::FFT_MOD;
 * ```
 *
 * @var FFT_MOD;
 */


/**
 * @ingroup math
 * @brief Fetches Fibonacci numbers.
 *
 * Fetches Fibonacci numbers that fit in @primitive{uint64_t} (less than @tt{2^64}).
 *
 * #### Examples
 *
 * ```cpp
 * // Prints 5th Fibonacci number.
 * std::cout << tgen::math::fibonacci()[5] << std::endl; // Prints "5".
 * ```
 *
 * @fn fibonacci();
 */


/**
 * @ingroup math
 * @brief Generates a random partition of a number.
 *
 * @param n Number to partition.
 * @param part_left Minimum part value.
 * @param part_right Maximum part value.
 *
 * @pre
 * @tt{@pname{n} > 0}. <br>
 * @tt{@pname{part_left} > 0}.
 *
 * Partition is ordered (so technically a composition). That is, @tt{(1, 1, 2) != (1, 2, 1)}.
 * If @pname{part_right} is not set, @pname{part_right} is considered to be @pname{n} (unbounded).
 *
 * @return A uniformly random ordered partition of @pname{n} with values in @tt{[@pname{part_left}, @pname{part_right}]}.
 *
 * @throws std::runtime_error if there is no such partition.
 *
 * @note Distribution might be slightly biased because of floating point arithmetic.
 *
 * #### Time complexity
 *
 * @tt{O(@pname{n})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Random partition of 10 into parts in [2, 3].
 * auto part = tgen::math::gen_partition(10, 2, 3);
 * ```
 *
 * @fn gen_partition(int n, int part_left = 1, std::optional<int> part_right = std::nullopt);
 */


/**
 * @ingroup math
 * @brief Generates a random partition with fixed size of a number.
 *
 * @param n Number to partition.
 * @param k Number of parts.
 * @param part_left Minimum part value.
 * @param part_right Maximum part value.
 *
 * @pre
 * @tt{@pname{n} >= @pname{k} > 0}. <br>
 * @tt{@pname{part_left} >= 0}.
 *
 * Partition is ordered (so technically a composition). That is, @tt{(1, 1, 2) != (1, 2, 1)}.
 * If @pname{part_right} is not set, @pname{part_right} is considered to be @pname{n} (unbounded).
 *
 * @return A uniformly random ordered partition of @pname{n} with length @pname{k} and values
 * in @tt{[@pname{part_left}, @pname{part_right}]}.
 *
 * @throws std::runtime_error if there is no such partition.
 *
 * @note Distribution might be slightly biased because of floating point arithmetic.
 *
 * #### Time complexity
 *
 * @tt{O(@pname{n})} time/memory if @pname{part_right} is not set; <br>
 * @tt{O(@pname{n} * @pname{k})} time/memory otherwise.
 *
 * #### Examples
 *
 * ```cpp
 * // Random partition of 10 into 4 parts in [2, 3].
 * auto part = tgen::math::gen_partition_fixed_size(10, 4, 2, 3);
 * ```
 *
 * @fn gen_partition_fixed_size(int n, int k, int part_left = 0, std::optional<int> part_right = std::nullopt);
 */


/**
 * @ingroup math
 * @brief Generates a fast non-uniform partition with fixed size.
 *
 * @param n Number to partition.
 * @param k Number of parts.
 * @param part_left Minimum part value.
 * @param part_right Maximum part value.
 *
 * @pre
 * @tt{@pname{n} >= @pname{k} > 0}. <br>
 * @tt{@pname{part_left} >= 0}.
 *
 * Partition is ordered (so technically a composition). That is, @tt{(1, 1, 2) != (1, 2, 1)}.
 * If @pname{part_right} is not set, @pname{part_right} is considered to be @pname{n} (unbounded).
 *
 * Inspired by <a href="https://github.com/ifsmirnov/jngen/blob/master/doc/math.md">jngen</a>:
 * draw @tt{@pname{k} - 1} random delimiters with replacement, sort them,
 * and recover part sizes from the gaps.
 *
 * @return A random ordered partition of @pname{n} with length @pname{k} and values in
 * @tt{[@pname{part_left}, @pname{part_right}]}.
 *
 * @throws std::runtime_error if there is no such partition.
 *
 * @note This operation is not uniformly random.
 *
 * #### Time complexity
 *
 * @tt{O(@pname{k} log @pname{k})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Fast partition of 10^18 into 10^6 parts.
 * auto part = tgen::math::gen_partition_fixed_size_fast(1e18, 1e6);
 * ```
 *
 * @fn gen_partition_fixed_size_fast(uint64_t n, int k, uint64_t part_left = 0, std::optional<uint64_t> part_right = std::nullopt);
 */


/**
 * @ingroup math
 * @brief Partitions a vector into @pname{k} ordered groups.
 *
 * @param elements Values to partition (order preserved; not shuffled).
 * @param k Number of groups.
 * @param min_size Minimum size of each group.
 * @param max_size Maximum size of each group (defaults to unbounded).
 *
 * @return @tt{k} groups whose sizes form a random composition of @tt{elements.size()}
 * with the given bounds. Elements keep their relative order within the concatenation
 * of the groups.
 *
 * If @pname{max_size} is not set, group sizes are drawn uniformly via
 * @ref gen_partition_fixed_size. If @pname{max_size} is set, sizes use the faster
 * non-uniform @ref gen_partition_fixed_size_fast instead. Only the group sizes are
 * random; element order is unchanged.
 *
 * @note This function is not always uniform: group sizes are uniform only when
 * @pname{max_size} is not set.
 *
 * #### Time complexity
 *
 * @tt{O(n)} if @pname{max_size} is not set (uniform, via @ref gen_partition_fixed_size); <br>
 * @tt{O(n + k log k)} if @pname{max_size} is set (fast, via @ref gen_partition_fixed_size_fast).
 *
 * #### Examples
 *
 * ```cpp
 * // Uniform group sizes (minimum 1 per group).
 * auto uniform = tgen::math::partition_elements({1, 2, 3, 4, 5}, 2, 1);
 * // Bounded group sizes (fast, non-uniform).
 * auto bounded = tgen::math::partition_elements({1, 2, 3, 4, 5}, 2, 1, 4);
 * ```
 *
 * @fn partition_elements(std::vector<T> elements, int k, int min_size = 0, std::optional<uint64_t> max_size = std::nullopt);
 */

};

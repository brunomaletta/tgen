#include "../single_include/tgen.h"

namespace tgen {

/**
 * @defgroup misc Miscellaneous
 * @brief Miscellaneous generation.
 */





 /**
 * @ingroup misc
 * @brief List of integers that force collision on @tt{@namespace{std}::unordered_set}.
 *
 * @param size Size of the list.
 *
 * Creates hack for both @tt{@namespace{std}::unordered_set} and @tt{@namespace{std}::unordered_map},
 * forcing quadratic behavior. The hack might not be effective due to differences in @tt{C++} implementations.
 *
 * @note This function benefits from @ref tgen::set_compiler and @ref tgen::set_cpp_version information.
 *
 * #### Complexity
 *
 * @tt{O(@pname{size})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates values that force collision.
 * std::vector<long long> hack = tgen::misc::unordered_hack(1e6);
 * ```
 *
 * @fn std::vector<long long> misc::unordered_hack(int size);
 */

};
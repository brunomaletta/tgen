#include "../single_include/tgen.h"

namespace tgen {

/**
 * @defgroup str Strings
 * @brief Generation of strings.
 *
 * Its instances have the properties:
 * - @tt{tgen::is_sequential}
 * - @tt{tgen::has_subset_defined}
 *
 * ## Regex
 *
 * Regex syntax compatible with testlib's regex.
 *
 * Operations:
 * - A single character yields itself (@tt{a}, @tt{3}).
 * - A list of characters inside square braces yields any a random element
 *   from the list (@tt{[abc123]}).
 *   - A range of characters inside @tt{[]} is equivalent to listing them (@tt{[a-z1-9A-Z]}).
 * - A pattern followed by @tt{{n}} yields the pattern repeated n times (@tt{a{3}}).
 * - A pattern followed by @tt{{l,r}} yields the pattern repeated between @tt{l} and @tt{r}
 *   times (@tt{a{3,5}}).
 * - A list of patterns separated by @tt{|} yields a random pattern from the
 *   list (@tt{abc|def|ghi}).
 * - Parentheses can be used for grouping (@tt{a((a|b){3})}).
 *
 * Operations defined by @tt{{n}} and @tt{{l,r}} are applied to what comes before it: a character,
 * a group defined by @tt{[]} or @tt{()}, or @tt{{n}}/@tt{{l,r}} expressions.
 *
 * <b>Regex generation is uniform</b> (each string has the same probability of being generated), as long
 * as each generated string can be generated uniquely from the regex. Otherwise, the probability of
 * each string being generated is proportional to the number of ways it cab be generated from the regex.
 *
 * Examples:
 * 1. @tt{str("0 | [1-9][0-9]{0,2} | 1000")} generates random numbers in @tt{[0, 1000]}.
 * 2. @tt{str("a[b-d]{2}|e")} generates @tt{e} or a random string of length 3, with
 *                       the first character being @tt{a} and the second and
 *                       third characters being @tt{b}, @tt{c}, or @tt{d}.
 * 3. @tt{str("[1-9][0-9]{%d}", n-1)} generates @tt{n}-digit numbers.
 *
 * ### Examples
 *
 * Prints a random string of 20 lower ou uppercase letters.
 *
 * ```cpp
 * // Prints a random string of 20 lower and uppercase letters.
 * std::cout << tgen::str(20, "[a-zA-Z]").gen() << std::endl;
 * // "OewztXVHjOvOTZwYWRrf"
 * ```
 *
 * Prints 2 uniformly random numbers in @tt{[0, 10^n]}.
 *
 * ```cpp
 * auto leq1eN = tgen::str("0 | [1-9][0-9]{0,%d} | 10{%d}", n-1, n);
 * std::cout << leq1eN.gen() << " " << leq1eN.gen() << std::endl;
 * // "843 647", for n = 3
 * ```
 */





 /**
 * @ingroup str
 * @brief String generator.
 *
 * Defines a set of strings, subject to restrictions.
 *
 * A uniformly random @tt{tgen::str::instance}
 * from this set of strings (that satisfies the restrictions) can be
 * generated with @tt{tgen::str::gen}.
 *
 * @struct str;
 */


 /**
 * @brief Creates string generator define by size and range of characters.
 *
 * @param size Size of the string.
 * @param value_l Left endpoint of character range.
 * @param value_r Right endpoint of character range.
 *
 * Defines a generator of strings of length @pname{size} with characters in
 * @tt{[@pname{value_l}, @pname{value_r}]}.
 *
 * #### Examples
 *
 * ```cpp
 * // Strings of lowercase letters of size 10.
 * auto str_gen = tgen::str(10, 'a', 'z');
 * ```
 *
 * @fn str::str(int size, char value_l = 'a', char value_r = 'z');
 */


 /**
 * @brief Creates string generator define by character set.
 *
 * @param size Size of the string.
 * @param chars Character set.
 *
 * Defines a generator of strings of length @pname{size} with characters in @pname{chars}.
 *
 * #### Examples
 *
 * ```cpp
 * // Strings size 10 with characters that are either 'a', 'e', or 'i'.
 * auto seq_gen = tgen::str(10, {'a', 'e', 'i'});
 * ```
 *
 * @fn str::str(int size, std::set<char> chars);
 */


 /**
 * @brief Creates string generator define by regex.
 *
 * @param regex Regex.
 * @param args Arguments for the regex.
 *
 * Defines a generator of strings generated by @pname{regex} (see @ref str), with the given @pname{args}.
 *
 * #### Examples
 *
 * ```cpp
 * // Numbers from from 0 up to 10^30.
 * auto leq1e30 = tgen::str("0 | [1-9][0-9]{0,%d} | 10{%d}", 30-1, 30);
 * ```
 *
 * @fn str::str(const std::string &regex, Args &&...args);
 */


/**
 * @brief Restricts generator s.t. character at index is fixed.
 *
 * @param idx Index.
 * @param character Character.
 *
 * @throws std::runtime_error if the generator was created from
 *         a regex (restrictions cannot be added for regex).
 *
 * #### Examples
 *
 * ```cpp
 * // Strings of 5 lowercase letters starting with 'x'.
 * auto str_gen = tgen::str(5, 'a', 'z').fix(0, 'x');
 * ```
 *
 * @fn str &str::fix(int idx, char character);
 */


/**
 * @brief Restricts generator s.t. values at two indices are the same.
 *
 * @param idx_1 First index.
 * @param idx_2 Second index.
 *
 * @throws std::runtime_error if the generator was created from
 *         a regex (restrictions cannot be added for regex).
 *
 * #### Examples
 *
 * ```cpp
 * // Strings of 7 lowercase letters that start and end with the same character.
 * auto str_gen = tgen::str(7, '0', '9').equal(0, 6);
 * ```
 *
 * @fn str &str::equal(int idx_1, int idx_2);
 */


/**
 * @brief Restricts generator s.t. all values at index range are the same.
 *
 * @param left Left endpoint of index range (inclusive).
 * @param right Right endpoint of index range (inclusive).
 *
 * @throws std::runtime_error if the generator was created from
 *         a regex (restrictions cannot be added for regex).
 *
 * #### Examples
 *
 * ```cpp
 * // Strings of 10 lowercase letters with a run of 4 equal characters at the start.
 * auto str_gen = tgen::str(10, 'a', 'z').equal_range(0, 3);
 * ```
 *
 * @fn str &str::equal_range(int left, int right);
 */


/**
 * @brief Restricts generator s.t. range is a palindrome.
 *
 * @param left Left endpoint of the index range (inclusive).
 * @param right Right endpoint of the index range (inclusive).
 *
 * @throws std::runtime_error if the generator was created from
 *         a regex (restrictions cannot be added for regex).
 *
 * #### Examples
 *
 * ```cpp
 * // Strings of 10 lowercase letters that are the concatenation of two length 5 palindromes.
 * auto str_gen = tgen::str(10, 'a', 'z').palindrome(0, 4).palindrome(5, 9);
 * ```
 *
 * @fn str &str::palindrome(int left, int right);
 */


/**
 * @brief Restricts generator s.t. string is a palindrome.
 *
 * @throws std::runtime_error if the generator was created from
 *         a regex (restrictions cannot be added for regex).
 *
 * #### Examples
 *
 * ```cpp
 * // Palindromes of 10 lowercase letters.
 * auto str_gen = tgen::str(10, 'a', 'z').palindrome();
 * ```
 *
 * @fn str &str::palindrome();
 */


/**
 * @brief Restricts generator s.t. all characters in index set are distinct.
 *
 * @param indices Index set.
 *
 * @note Generation might fail if restrictions are considered to be too complex!
 *       The restrictions are considered too complex if the following condition does not hold.
 *       Consider the graph defined with vertices as the @tt{tgen::str::distinct} sets added,
 *       and there is an edge between two vertices if they share an index. Note that you need
 *       to consider indices (directed or indirectly) connected by equality restrictions as
 *       being the same. This resulting graph must be a acyclic. Moreover, for every tree in this
 *       graph, all of its indices with a @tt{tgen::str::set} operation must be covered by a single
 *       distinct restriction set.
 *
 * @throws std::runtime_error if the generator was created from
 *         regex (restrictions cannot be added for regex).
 *
 * #### Examples
 *
 * ```cpp
 * // Strings of 10 lowercase letters with first 3 characters distinct.
 * auto str_gen = tgen::str(10, 'a', 'z').distinct({0, 1, 2});
 * ```
 *
 * @fn str &str::distinct(std::set<int> indices);
 */


/**
 * @brief Restricts generator s.t. characters at two indices are different.
 *
 * @param idx_1 First index.
 * @param idx_2 Second index.
 *
 * @throws std::runtime_error if the generator was created from
 *         a regex (restrictions cannot be added for regex).
 *
 * Equivalent to @tt{tgen::str::distinct({idx_1, idx_2})}.
 *
 * #### Examples
 *
 * ```cpp
 * // Strings of 10 lowercase letters with the first and last characters different.
 * auto str_gen = tgen::str(10, 'a', 'z').different(0, 9);
 * ```
 *
 * @fn str &str::different(int idx_1, int idx_2);
 */


/**
 * @brief Restricts generator s.t. all characters are distinct.
 *
 * Equivalent to @tt{tgen::str::distinct({0, 1, ... size-1})}.
 *
 * @note If you add this restriction, do not add another `tgen::str::distinct` restriction! Generation might fail otherwise.
 *
 * @throws std::runtime_error if the generator was created from
 *         a regex (restrictions cannot be added for regex).
 *
 * #### Examples
 *
 * ```cpp
 * // Strings consisting of 10 distinct lowercase letters.
 * auto s = tgen::str(10, 'a', 'z').distinct();
 * ```
 *
 * @fn str &str::distinct();
 */


/**
 * @brief Generates a random instance from the set of valid strings.
 *
 * @return A uniformly random @tt{tgen::str::instance} satisfying the restrictions,
 *         or (for regex generators) a random match according to the regex semantics
 *         described in @ref str.
 *
 * @note For regex, the generation is only guaranteed to be uniform if there is a unique
 *       way to generate each string generated by the regex (see @ref str).
 *
 * @throws std::runtime_error if there is no valid string satisfying all restrictions.
 *
 * #### Complexity
 *
 * If created from restrictions: @tt{O(n log n)}.
 *
 * If created from regex: expected linear.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints a random number from 0 to 10^3.
 * std::cout << tgen::str("0 | [1-9][0-9]{0,%d} | 10{%d}", 3-1, 3).gen() << std::endl;
 * ```
 *
 * @fn str::gen() const;
 */


/**
 * @brief Returns the prefix of the infinite word "abacabad...".
 *
 * @param n Length of the prefix.
 *
 * @return A @tt{tgen::str::instance} with the prefix of length @pname{n} of @tt{"abacabad..."}.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints "abacaba".
 * std::cout << tgen::str::abacaba(7) << std::endl;
 * ```
 *
 * @fn str::abacaba(int n);
 */





/**
 * @ingroup str
 * @brief String instance.
 *
 * Instance of a string.
 *
 * It can be deterministically operated upon (see @ref generator_instance_op for random operations) 
 * and printed through @tt{@namespace{std}::cout}.
 *
 * @struct str::instance;
 */


/**
 * @brief Creates a string instance from a @texttt{@namespace{std}::@type{string}}.
 *
 * @param str The @texttt{@namespace{std}::@type{string}} representing the instance.
 *
 * #### Examples
 *
 * ```cpp
 * // Creates and prints an instance from a std::string.
 * std::string s = "aba";
 * tgen::str::instance inst(aba);
 * std::cout << inst << std::endl; // Prints "aba".
 * ```
 *
 * @fn str::instance::instance(const std::string &str);
 */


/**
 * @brief Returns the size of the string instance.
 *
 * @return The number of characters in the instance.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints the size of an instance.
 * tgen::str::instance inst = "aba";
 * std::cout << inst.size() << std::endl; // Prints "3".
 * ```
 *
 * @fn int str::instance::size() const;
 */


/**
 * @brief Accesses the character at some position of the instance.
 *
 * @param idx Index to be accessed.
 *
 * @return The character at index @pname{idx}.
 *
 * #### Examples
 *
 * ```cpp
 * // Changes and prints a position of an instance.
 * tgen::str::instance inst = "aba";
 * ++inst[1];
 * std::cout << inst[1] << std::endl; // Prints "c".
 * ```
 *
 * @fn char &str::instance::operator[](int idx);
 */


/**
 * @brief Sorts the characters in non-decreasing order.
 *
 * #### Complexity
 *
 * @tt{O(n log n)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Sorts and prints an instance.
 * tgen::str::instance inst = "aba";
 * std::cout << inst.sort() << std::endl; // Prints "aab".
 * ```
 *
 * @fn str::instance::sort();
 */


/**
 * @brief Reverses the instance.
 *
 * #### Complexity
 *
 * @tt{O(n)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Reverses and prints an instance.
 * tgen::str::instance inst = "bac";
 * std::cout << inst.reverse() << std::endl; // Prints "cab".
 * ```
 *
 * @fn str::instance::reverse();
 */


/**
 * @brief Sets all characters to lowercase.
 *
 * #### Complexity
 *
 * @tt{O(n)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Sets an instance to lowercase and prints it.
 * tgen::sequence<int>::instance inst = "abC";
 * std::cout << inst.lowercase() << std::endl; // Prints "ABC".
 * ```
 *
 * @fn str::instance::lowercase();
 */


/**
 * @brief Sets all characters to uppercase.
 *
 * #### Complexity
 *
 * @tt{O(n)}.
 *
 * #### Examples
 *
 * ```cpp
 * // Sets an instance to uppercase and prints it.
 * tgen::sequence<int>::instance inst = "abC";
 * std::cout << inst.uppercase() << std::endl; // Prints "abc".
 * ```
 *
 * @fn str::instance::uppercase();
 */


/**
 * @brief Concatenates two instances.
 *
 * @param rhs The right-hand side.
 *
 * @return The concatenation.
 *
 * #### Complexity
 *
 * Linear.
 *
 * #### Examples
 *
 * ```cpp
 * // Concatenates and prints two instances.
 * tgen::str s = tgen::str(5, 'a', 'z').distinct();
 * std::cout << s.gen() + s.gen() << std::endl;
 * ```
 *
 * @fn str::instance::operator+(const instance &rhs);
 */


/**
 * @brief Prints the instance to a @texttt{@namespace{std}::@type{ostream}}.
 *
 * The string is printed with no end of line.
 *
 * #### Examples
 *
 * ```cpp
 * // Prints an instance.
 * std::cout << tgen::str::instance("aba") << std::endl; // Prints "aba".
 * ```
 *
 * @fn str::instance::operator<<(std::ostream &out, const instance &inst);
 */


/**
 * @brief Converts the instance to a @texttt{@namespace{std}::@type{string}}.
 *
 * @return A @texttt{@namespace{std}::@type{string}} representing the instance.
 *
 * #### Examples
 *
 * ```cpp
 * // Convoluted way to reverse a string.
 * std::string s = "bac";
 * s = tgen::str::instance(s).reverse().to_std();
 * // s = "cab".
 * ```
 *
 * @fn str::instance::to_std() const;
 */

};

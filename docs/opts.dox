#include "../single_include/tgen.h"

namespace tgen {

/**
 * @defgroup opts Registering and Opts
 * @brief Registering and opts parsing.
 *
 * ### Registering
 *
 * The first line of your generator should be:
 *
 * ```cpp
 * #include "tgen.h"
 * 
 * int main(int argc, char** argv) {
 *     tgen::register_gen(argc, argv);
 *     
 *     // Rest of the generator.
 * }
 * ```
 * 
 * This does two things:
 * 1. Sets up the seed for random generator based on the arguments
 *    (excluding the executable name). That is, @tt{./a.out -n 10} and
 *    @tt{./b.out -n 10} will use the same seed.
 * 2. Parses the opts (given in the arguments).
 *
 * ### Opts
 * 
 * Opts are a list of either named or positional options.
 *
 * Named options is given in one of the following formats:
 * 1. @tt{-keyname=value} or @tt{--keyname=value} (ex. @tt{-n=10}, @tt{--test-count=20})
 * 2. @tt{-keyname value} or @tt{--keyname value} (ex. @tt{-n 10}, @tt{--test-count 20})
 *
 * Positional options are numbered from 0 sequentially.
 *
 * For example, if you compile your code to @tt{a.out}, calling
 * @tt{./a.out -n 10 str --q=5 -1.1e2} results in the following opts:
 * - Named
 *   - @tt{n}: @tt{10}
 *   - @tt{q}: @tt{5}
 * - Positional
 *   - @tt{0}: @tt{str}
 *   - @tt{1}: @tt{-110}
 * 
 * #### Consuming opts
 * 
 * You can consume the opts by using @tt{opt<>}:
 * 
 * ```cpp
 * int n = tgen::opt<int>("n");
 * std::string s = tgen::opt<std::string>(0, ""); // Default value, if opt is not found.
 * ```
 */



/**
 * @ingroup opts
 * @brief Checks if opt at some index exists.
 *
 * @param index Index of positional opt.
 *
 * @return If there is positional opt at @pname{index}.
 *
 * #### Examples
 *
 * ```cpp
 * // Checks if there is an opt at 0.
 * if (tgen::has_opt(0)) std::cout << "opt found!" << std::endl; // Prints "opt found!".
 * ```
 *
 * @fn has_opt(std::size_t index);
 */


/**
 * @ingroup opts
 * @brief Checks if opt with some key exists.
 *
 * @param key Key of named opt.
 *
 * @return If there is named opt with @pname{key}.
 *
 * #### Examples
 *
 * ```cpp
 * // Checks if there is an opt with "q".
 * if (tgen::has_opt("q")) std::cout << "q found!" << std::endl; // Prints "q found!".
 * ```
 *
 * @fn has_opt(const std::string &key);
 */


/**
 * @ingroup opts
 * @brief Gets opt by key.
 *
 * @tparam T Type of the opt.
 *
 * @param index index to fetch.
 * @param default_value Default value to be returned, if @pname{index} is not found.
 *
 * @return The value of opt at @pname{index}. If not found, returns @pname{default_value}.
 *
 * @throws std::runtime_error if opt is not found and @pname{default_value} is not given.
 *
 * #### Examples
 *
 * ```cpp
 * // Consumes opt at 0.
 * int q = tgen::opt<int>(0);
 * ```
 *
 * @fn opt(size_t index, std::optional<T> default_value = std::nullopt);
 */


/**
 * @ingroup opts
 * @brief Gets opt by key.
 *
 * @tparam T Type of the opt.
 *
 * @param key Key to fetch.
 * @param default_value Default value to be returned, if @pname{key} is not found.
 *
 * @return The value of opt with @pname{key}. If not found, returns @pname{default_value}.
 *
 * @throws std::runtime_error if opt is not found and @pname{default_value} is not given.
 *
 * #### Examples
 *
 * ```cpp
 * // Consumes opt with "q".
 * int q = tgen::opt<int>("q");
 * ```
 *
 * @fn opt(const std::string &key, std::optional<T> default_value = std::nullopt);
 */


/**
 * @ingroup opts
 * @brief Sets up the generator.
 *
 * @param argc Argument count, from the main function.
 * @param argv Argument vector, from the main function.
 *
 * Sets up the opts, and the seed of the random number generator.
 * The seed is dependent on the arguments (excluding the executable name).
 *
 * #### Examples
 *
 * ```cpp
 * #include "tgen.h"
 *
 * int main(int argc, char** argv) {
 *     // Registers generator.
 *     tgen::register_gen(argc, argv);
 * }
 * ```
 *
 * @fn register_gen(int argc, char **argv);
 */


/**
 * @ingroup opts
 * @brief Sets up the generator without arguments.
 *
 * @param seed Seed for the random number generator.
 *
 * #### Examples
 *
 * ```cpp
 * #include "tgen.h"
 *
 * int main() {
 *     // Registers generator with seed 42.
 *     tgen::register_gen(42);
 * }
 * ```
 *
 * Or even:
 *
 * ```cpp
 * #include "tgen.h"
 *
 * int main() {
 *     // Registers generator with default seed.
 *     tgen::register_gen();
 * }
 * ```
 *
 * @fn register_gen(std::optional<long long> seed = std::nullopt);
 */


/**
 * @ingroup opts
 * @brief Sets C++ version.
 *
 * @param version The C++ version (17, 20, or 23).
 *
 * This can be used by some functions to find counter testcases for specific systems.
 *
 * #### Examples
 *
 * ```cpp
 * // Sets as C++17.
 * tgen::set_cpp_version(17);
 * ```
 *
 * This can also be set by command argument:
 * - @tt{./executable tgen::CPP:20}: equivalent to @tt{tgen::set_cpp_version(20)}.
 *
 * @fn set_cpp_version(int version);
 */


/**
 * @ingroup opts
 * @brief Sets compiler.
 *
 * @param compiler The compiler (@tt{@namespace{tgen}::@type{gcc}(...)} or @tt{@namespace{tgen}::@type{clang}(...)}).
 *
 * This can be used by some functions to find counter testcases for specific systems.
 *
 * #### Examples
 *
 * ```cpp
 * // Sets as GCC (version unspecified).
 * tgen::set_compiler(tgen::gcc());
 *
 * // Sets as GCC 15.
 * tgen::set_compiler(tgen::gcc(15));
 *
 * // Sets as GCC 15.2.
 * tgen::set_compiler(tgen::gcc(15, 2));
 *
 * // Sets as clang (version unspecified).
 * tgen::set_compiler(tgen::clang());
 * ```
 *
 * This can also be set by command argument:
 * - @tt{./executable tgen::GCC}: equivalent to @tt{tgen::set_compiler(tgen::gcc())}.
 * - @tt{./executable tgen::GCC:15}: equivalent to @tt{tgen::set_compiler(tgen::gcc(15))}.
 * - @tt{./executable tgen::GCC:15.2}: equivalent to @tt{tgen::set_compiler(tgen::gcc(15, 2))}.
 *
 * @fn set_compiler(detail::compiler_value compiler);
 */

};
